---
// The landing page's shell: everything search engines and link previews read, the fonts,
// the background, and the motion script.
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/landing.css";
import { DESCRIPTION, FAQ, REPO, SITE_URL, TITLE } from "../data";

const base = import.meta.env.BASE_URL;
const og = new URL("og.png", SITE_URL).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}#website`,
      url: SITE_URL,
      name: "Job Application Tracker",
      description: DESCRIPTION,
      inLanguage: "en",
    },
    {
      "@type": "SoftwareApplication",
      name: "Job Application Tracker",
      alternateName: "jat",
      description: DESCRIPTION,
      url: SITE_URL,
      image: og,
      screenshot: new URL("screenshot.png", SITE_URL).href,
      applicationCategory: "BusinessApplication",
      applicationSubCategory: "Job search tracker",
      operatingSystem: "Linux, macOS",
      softwareVersion: "1.1.4",
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      author: { "@type": "Person", name: "Kai Waddington", url: "https://github.com/waddington" },
      featureList: [
        "Kanban board of job applications",
        "Recruiter and agency CRM",
        "Interview rounds and coding tasks",
        "Follow-up reminders and a Today page of what to do next",
        "Offer comparison",
        "Sankey diagram of the job search funnel",
        "Markdown notes, files and exported emails",
        "Private: no account, no cloud, no AI, no tracking; data stays on your computer",
      ],
    },
    {
      "@type": "SoftwareSourceCode",
      name: "job-application-tracker",
      codeRepository: REPO,
      license: "https://www.apache.org/licenses/LICENSE-2.0",
    },
    {
      "@type": "FAQPage",
      mainEntity: FAQ.map(({ q, a }) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a.replaceAll("`", "") },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en" data-palette="paper">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {
      /* Dev server only (`pnpm dev`): ?palette=paper, forest, ember or indigo previews another
         colour scheme. The published site is always paper. */
      import.meta.env.DEV && <script is:inline>
        const palette = new URLSearchParams(location.search).get("palette");
        if (palette) document.documentElement.dataset.palette = palette;
      </script>
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={SITE_URL} />
    <meta name="theme-color" content="#f6f1e7" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Job Application Tracker" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta
      property="og:image:alt"
      content="Job Application Tracker. No account. No cloud. No AI. No tracking."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={og} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <div class="backdrop" aria-hidden="true">
      <div class="aurora a1"></div>
      <div class="aurora a2"></div>
      <div class="aurora a3"></div>
      <div class="grid"></div>
      <div class="noise"></div>
    </div>
    <slot />
    <p class="sr-only" aria-live="polite" id="announce"></p>
    {import.meta.env.DEV && (
      <div class="palette-switch" aria-label="Preview a colour scheme (dev only)">
        {["indigo", "paper", "forest", "ember"].map((p) => (
          <a href={`?palette=${p}`}>{p}</a>
        ))}
      </div>
    )}
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
