---
// The app in use, inside the hero's front window (docs/rfc/website-redesign.md §11, part 3). Light-mode screenshots
// of the demo app (made-up data) sit on a 1440 x 900 stage at the app's own pixel positions, with the moving parts
// on top: a to-do ticked, a board card (cut from the screenshot) dragged to the next stage, a stage changed, the
// Sankey drawing in. A cursor drives it on a loop, at twice the pace of the concept it comes from.
// Retaking a screenshot means measuring the positions below again.
// Decorative only: hidden from assistive tech, nothing focusable; the window's still screenshot keeps the honest
// description. It stays hidden (and its images unloaded) until the script starts it: never without JavaScript or
// under reduced motion, and it plays only while on screen in a visible tab.
import { getImage, Image } from "astro:assets";
import chrome from "../../assets/demo/chrome.png";
import today from "../../assets/demo/today.png";
import board from "../../assets/demo/board.png";
import role from "../../assets/demo/role.png";
import insights from "../../assets/demo/insights.png";

// The Applied column's cards where the board's screenshot has them: the first is dragged, the rest move up.
const APPLIED_X = 461;
const applied = [
  { top: 305, h: 107 },
  { top: 422, h: 90 },
  { top: 522, h: 129 },
  { top: 660, h: 107 },
];
const img = {
  widths: [720, 1020, 1440],
  sizes: "(max-width: 760px) 92vw, 1020px",
  format: "webp" as const,
  loading: "lazy" as const,
  decoding: "async" as const,
  alt: "",
};
// The later screens carry their sources as data-src / data-srcset; the script sets them one step ahead of use.
const later = async (src: ImageMetadata) => {
  const r = await getImage({ src, widths: img.widths, format: img.format });
  return {
    "data-src": r.src,
    "data-srcset": r.srcSet.attribute,
    width: r.attributes.width,
    height: r.attributes.height,
  };
};
const [boardImg, roleImg, insightsImg] = await Promise.all([board, role, insights].map(later));
---

<div class="demo" data-demo aria-hidden="true">
  <div class="stage" data-stage>
    <Image src={chrome} {...img} data-first />
    <span class="hl shade" data-hl></span>
    <span class="hl fill" data-hl></span>
    <div class="vp">
      <div class="pg on" data-page="today">
        <div class="pin" data-scroll>
          <Image src={today} {...img} data-first />
          <span class="dim" data-todo></span>
          <span class="check" data-todo>
            <svg viewBox="0 0 12 12">
              <path d="M2.5 6.2l2.4 2.4 4.6-5"></path>
            </svg>
          </span>
          <span class="strike" data-todo></span>
        </div>
      </div>
      <div class="pg" data-page="board">
        <div class="pin">
          <img {...boardImg} sizes={img.sizes} alt="" decoding="async" data-later="board" />
          <div class="well applied">
            <i data-well="Applied" />
          </div>
          <div class="well screen">
            <i data-well="Screen" />
          </div>
          <span class="count applied" data-count="Applied">
            4
          </span>
          <span class="count screen" data-count="Screen">
            0
          </span>
          {applied.map((c, i) => (
            <div
              class="card"
              style={`left:${APPLIED_X}px;top:${c.top}px;height:${c.h}px`}
              data-card={i === 0 ? "drag" : "below"}
            >
              <img
                {...boardImg}
                sizes={img.sizes}
                style={`position:absolute;left:${-APPLIED_X}px;top:${-c.top}px`}
                alt=""
                decoding="async"
                data-later="board"
              />
            </div>
          ))}
        </div>
      </div>
      <div class="pg" data-page="role">
        <div class="pin" data-scroll>
          <img {...roleImg} sizes={img.sizes} alt="" decoding="async" data-later="role" />
          <span class="stage-badge old" data-badge-old>
            Interviewing
          </span>
          <span class="stage-badge new" data-badge-new>
            Final
          </span>
          <div class="menu" data-menu>
            <small>Usual next</small>
            <span class="pick">Final</span>
            <span>Offer</span>
            <span>Declined</span>
            <span>Rejected</span>
            <span>Withdrawn</span>
            <span>Ghosted</span>
          </div>
        </div>
      </div>
      <div class="pg" data-page="insights">
        <div class="pin">
          <img {...insightsImg} sizes={img.sizes} alt="" decoding="async" data-later="insights" />
          <span class="cover" data-cover></span>
        </div>
      </div>
    </div>
    <div class="toast" data-toast>
      <i></i>
      <span data-toast-text></span>
    </div>
    <div class="cursor" data-cursor>
      <i class="ripple" data-ripple></i>
      <svg viewBox="0 0 24 24">
        <path d="M4 2.5l15.5 9.2-6.9 1.3 3.9 7.6-3 1.5-3.9-7.6L4.4 19z"></path>
      </svg>
    </div>
  </div>
</div>

<script>
  type Pos = [number, number];
  // The sidebar highlight's y for each page, and what the address bar shows.
  const SIDEBAR: Record<string, number> = { today: 66, board: 181, role: 181, insights: 570 };
  const URLS: Record<string, string> = {
    today: "/",
    board: "/applications?view=board",
    role: "/applications/01a204ed-07e1-78d3-b28a-efef20462196",
    insights: "/insights",
  };
  // Twice the concept's pace: holds on a screen halve, movement speeds up by the square root, so it stays smooth.
  const SPEED = 2;
  const hold = (ms: number) => ms / SPEED;
  const move = (ms: number) => ms / Math.SQRT2;
  class Stopped extends Error {}

  const demo = document.querySelector<HTMLElement>("[data-demo]");
  if (demo) setup(demo);

  function setup(demo: HTMLElement) {
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => demo.querySelector<T>(s)!;
    const $$ = (s: string) => [...demo.querySelectorAll<HTMLElement>(s)];
    const stage = $("[data-stage]");
    const win = demo.closest<HTMLElement>(".window");
    const url = win?.querySelector<HTMLElement>("[data-url]");
    const cursor = $("[data-cursor]");
    const ripple = $("[data-ripple]");
    const toastEl = $("[data-toast]");
    const card = $("[data-card='drag']");
    const below = $$("[data-card='below']");
    const wells = $$("[data-well]");
    const highlight = $$("[data-hl]");
    const pages = new Map($$("[data-page]").map((p) => [p.dataset.page!, p]));
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    // Fit the 1440 x 900 stage to the window (the observer hands over the size; nothing is read here).
    new ResizeObserver(([e]) => stage.style.setProperty("--k", String(e.contentRect.width / 1440))).observe(
      demo,
    );

    let inView = false;
    let run = 0;
    let wake: (() => void) | null = null;
    // Also paused while the window has swung away (the hero marks it inert).
    const playing = () => inView && !document.hidden && !win?.inert;
    const resume = () => {
      if (playing() && wake) {
        wake();
        wake = null;
      }
    };

    // Waits, pausing while off screen or in a hidden tab; throws if this run has been stopped.
    async function wait(ms: number, id: number) {
      let left = ms;
      while (left > 0) {
        if (id !== run) throw new Stopped();
        if (!playing()) await new Promise<void>((r) => (wake = r));
        const t0 = performance.now();
        await new Promise((r) => setTimeout(r, Math.min(left, 100)));
        left -= performance.now() - t0;
      }
      if (id !== run) throw new Stopped();
    }
    function place(el: HTMLElement, transform: string, ms: number, ease = "cubic-bezier(.45,.05,.25,1)") {
      el.style.transition = ms ? `transform ${ms}ms ${ease}` : "none";
      el.style.transform = transform;
    }
    let toastTimer = 0;
    function toast(text: string) {
      $("[data-toast-text]").textContent = text;
      toastEl.classList.add("on");
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toastEl.classList.remove("on"), hold(2600));
    }
    let current = "today";
    function go(name: string, fade = false) {
      const prev = pages.get(current)!;
      const next = pages.get(name)!;
      prev.classList.remove("on");
      prev.classList.add("out");
      setTimeout(() => prev.classList.remove("out"), 700);
      next.classList.toggle("fade", fade);
      next.classList.add("on");
      current = name;
      for (const el of highlight)
        place(el, `translateY(${SIDEBAR[name]}px)`, 420, "cubic-bezier(.3,.7,.2,1)");
      if (url) url.textContent = URLS[name];
    }
    // Loads a later screen's image (once), and the pieces cut from it.
    function load(name: string) {
      for (const i of demo.querySelectorAll<HTMLImageElement>(`img[data-later='${name}']`)) {
        if (i.srcset) continue;
        i.srcset = i.dataset.srcset!;
        i.src = i.dataset.src!;
      }
    }
    // Puts the moved pieces back; run while their pages are hidden, so nothing snaps in view.
    function resetPieces() {
      const moved = [card, ...below, ...wells, ...$$("[data-todo]"), $("[data-scroll]")];
      for (const el of moved) {
        place(el, "", 0);
        el.classList.remove("on", "lift");
      }
      // Once that has landed (the one read), their own CSS transitions come back for the next time round.
      void stage.offsetWidth;
      for (const el of moved) el.style.transition = "";
      place(pages.get("role")!.querySelector<HTMLElement>("[data-scroll]")!, "", 0);
      $("[data-count='Applied']").textContent = "4";
      $("[data-count='Screen']").textContent = "0";
      for (const s of ["[data-badge-old]", "[data-badge-new]", "[data-menu]"])
        $(s).classList.remove("on", "gone");
    }
    function reset() {
      resetPieces();
      $("[data-cover]").classList.remove("on");
      for (const [name, p] of pages) p.classList.toggle("on", name === "today");
      current = "today";
      for (const el of highlight) place(el, `translateY(${SIDEBAR.today}px)`, 0);
      if (url) url.textContent = URLS.today;
      toastEl.classList.remove("on");
    }

    async function loop(id: number) {
      let at: Pos = [1100, 520];
      const pause = (ms: number) => wait(hold(ms), id);
      const to = async (p: Pos, ms = 900) => {
        at = p;
        place(cursor, `translate(${p[0]}px, ${p[1]}px)`, move(ms));
        await wait(move(ms + 60), id);
      };
      const click = async () => {
        cursor.classList.add("down");
        ripple.animate(
          [
            { opacity: 1, transform: "scale(0.3)" },
            { opacity: 0, transform: "scale(1.8)" },
          ],
          { duration: 600, easing: "ease-out" },
        );
        await wait(move(160), id);
        cursor.classList.remove("down");
        await wait(move(140), id);
      };
      const scroll = async (page: string, y: number, ms: number) => {
        place(pages.get(page)!.querySelector<HTMLElement>("[data-scroll]")!, `translateY(${-y}px)`, move(ms));
        await wait(move(ms), id);
      };
      place(cursor, `translate(${at[0]}px, ${at[1]}px)`, 0);
      for (;;) {
        // Today: down to the to-dos, tick one. (Each next screen loads a step ahead.)
        load("board");
        await pause(900);
        await to([700, 560]);
        await scroll("today", 520, 1500);
        await to([303, 433]);
        await click();
        $$("[data-todo]").forEach((el) => el.classList.add("on"));
        toast("To-do done · Undo");
        await pause(1100);
        await scroll("today", 0, 1100);
        // The board: drag Adventure Works from Applied to Screen.
        await to([92, 201], 1000);
        await click();
        go("board");
        load("role");
        await pause(1000);
        await to([540, 350]);
        cursor.classList.add("down");
        card.classList.add("lift");
        await pause(250);
        place(card, "translate(192px, -4px) rotate(2deg)", move(1100));
        await to([732, 346], 1100);
        place(card, "translate(192px, 0)", move(260));
        card.classList.remove("lift");
        cursor.classList.remove("down");
        // The rest of Applied moves up; its well shortens by that card and Screen's grows to hold it.
        const settle = (el: HTMLElement, y: number) =>
          place(el, `translateY(${y}px)`, move(520), "cubic-bezier(.3,.7,.2,1)");
        below.forEach((c) => settle(c, -117));
        settle(wells[0], -117);
        settle(wells[1], 47);
        $("[data-count='Applied']").textContent = "3";
        $("[data-count='Screen']").textContent = "1";
        toast("Adventure Works moved to Screen · Undo");
        await pause(1400);
        // Contoso: open it, move it on to Final, read down the page.
        await to([920, 340]);
        await click();
        go("role");
        load("insights");
        await pause(1100);
        await to([308, 252]);
        await click();
        $("[data-menu]").classList.add("on");
        await pause(500);
        await to([300, 326], 600);
        await click();
        $("[data-menu]").classList.remove("on");
        $("[data-badge-old]").classList.add("gone");
        $("[data-badge-new]").classList.add("on");
        toast("Contoso moved to Final");
        await pause(1100);
        await to([1000, 600], 800);
        await scroll("role", 1250, 2600);
        await pause(700);
        await scroll("role", 2100, 1400);
        await pause(600);
        // Insights: the Sankey draws in.
        await to([78, 589], 1000);
        await click();
        go("insights", true);
        await pause(350);
        $("[data-cover]").classList.add("on");
        await to([980, 470], 1500);
        await pause(2600);
        // Home, and round again.
        await to([72, 86], 1000);
        await click();
        resetPieces();
        go("today", true);
        // Wait out Insights' fade (real time, not halved) before its curtain comes back.
        await wait(750, id);
        $("[data-cover]").classList.remove("on");
      }
    }

    // Start (show once the first screens are decoded) or stop (hide and reset) with the motion preference.
    async function mode() {
      const id = ++run;
      resume();
      if (reduce.matches) {
        demo.classList.remove("on", "shown");
        reset();
        return;
      }
      demo.classList.add("on");
      await Promise.all($$("img[data-first]").map((i) => (i as HTMLImageElement).decode().catch(() => {})));
      if (id !== run) return;
      demo.classList.add("shown");
      loop(id).catch((e) => {
        if (!(e instanceof Stopped)) throw e;
      });
    }

    new IntersectionObserver(([e]) => {
      inView = e.isIntersecting;
      resume();
    }).observe(demo);
    document.addEventListener("visibilitychange", resume);
    if (win) new MutationObserver(resume).observe(win, { attributes: true, attributeFilter: ["inert"] });
    reduce.addEventListener("change", mode);
    mode();
  }
</script>

<style>
  /* Over the window's still screenshot, the same size, so showing it shifts nothing. */
  .demo {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    aspect-ratio: 1440 / 900;
    overflow: hidden;
    /* The app's colours in light: its page, a board column over it, its ink and muted ink. */
    --page: #f4f1fb;
    --well: #f9f7fd;
    --app-ink: #2a1e3f;
    --app-muted: rgb(42 30 63 / 0.7);
    background: var(--page);
    /* A picture of the app: forced colours would turn the sidebar's highlight into a blank block. */
    forced-color-adjust: none;
    display: none;
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
  }
  .demo:global(.on) {
    display: block;
  }
  .demo:global(.shown) {
    opacity: 1;
  }
  .stage {
    position: absolute;
    left: 0;
    top: 0;
    width: 1440px;
    height: 900px;
    transform: scale(var(--k, 0.5));
    transform-origin: 0 0;
    font-family: "Inter Variable", system-ui, sans-serif;
    color: var(--app-ink);
    -webkit-font-smoothing: antialiased;
  }
  /* Outweighs the hero window's own rule for images: the pieces cut from the board need the full 1440 px. */
  .demo .stage :global(img) {
    display: block;
    width: 1440px;
    max-width: none;
    height: auto;
  }
  /* The sidebar's highlight, moved to the page shown. */
  .hl {
    position: absolute;
    left: 10px;
    top: 0;
    width: 209px;
    height: 41px;
    border-radius: 999px;
    transform: translateY(66px);
  }
  .hl.shade {
    box-shadow: 0 8px 22px -12px rgb(42 30 63 / 0.35);
  }
  /* White, lighter than the page under it: dodging lifts the lilac to white and leaves the ink dark. */
  .hl.fill {
    background: #101010;
    mix-blend-mode: color-dodge;
  }
  /* The content area right of the sidebar and under the header; each page is a full screenshot shifted into it. */
  .vp {
    position: absolute;
    left: 230px;
    top: 56px;
    width: 1210px;
    height: 844px;
    overflow: hidden;
    background: var(--page);
  }
  .pg {
    position: absolute;
    left: -230px;
    top: -56px;
    width: 1440px;
    opacity: 0;
    visibility: hidden;
    transform: translateX(60px);
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.3, 0.7, 0.2, 1),
      visibility 0s 0.6s;
  }
  .pg:global(.fade) {
    transform: none;
  }
  .pg:global(.on),
  .pg:global(.out) {
    visibility: visible;
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .pg:global(.on) {
    opacity: 1;
    transform: none;
    z-index: 2;
  }
  .pg:global(.out) {
    opacity: 0;
    transform: translateX(-40px);
    z-index: 1;
  }
  .pin {
    position: relative;
    background: var(--page);
  }

  /* Today: the to-do being ticked. */
  .check,
  .strike,
  .dim {
    position: absolute;
    opacity: 0;
  }
  .check {
    left: 297px;
    top: 947px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--app-ink);
    display: grid;
    place-items: center;
    transform: scale(0.6);
    transition:
      opacity 0.2s,
      transform 0.35s cubic-bezier(0.3, 1.4, 0.4, 1);
  }
  .check svg {
    width: 13px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .strike {
    left: 327px;
    top: 955px;
    width: 408px;
    height: 1.5px;
    background: var(--app-muted);
    opacity: 1;
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.5s 0.1s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .dim {
    left: 325px;
    top: 941px;
    width: 416px;
    height: 45px;
    background: #f3f0fa;
    transition: opacity 0.6s 0.4s;
  }
  .check:global(.on) {
    opacity: 1;
    transform: none;
  }
  .strike:global(.on) {
    transform: none;
  }
  .dim:global(.on) {
    opacity: 0.5;
  }

  /* The board: the two columns that change are covered below their headers and redrawn, the cards cut from it. */
  .well {
    position: absolute;
    top: 300px;
    width: 180px;
    height: 492px;
    overflow: hidden;
    background: var(--page);
  }
  .well i {
    position: absolute;
    left: 0;
    right: 0;
    top: -130px;
    border-radius: 0 0 26px 26px;
    background: var(--well);
  }
  /* Wider than its column, over the shadows its cards cast in the screenshot. */
  .well.applied {
    left: 438px;
    width: 204px;
  }
  .well.applied i {
    left: 12px;
    right: 12px;
    height: 608px;
  }
  .well.screen {
    left: 642px;
  }
  .well.screen i {
    height: 206px;
  }
  .count {
    position: absolute;
    top: 275px;
    width: 14px;
    background: var(--well);
    color: var(--app-muted);
    font-size: 12px;
    line-height: 20px;
    text-align: right;
  }
  .count.applied {
    left: 605px;
  }
  .count.screen {
    left: 797px;
  }
  .card {
    position: absolute;
    width: 158px;
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 18px 50px -24px rgb(42 30 63 / 0.28);
    transition:
      box-shadow 0.25s,
      scale 0.25s;
  }
  .card:global(.lift) {
    z-index: 3;
    scale: 1.04;
    box-shadow: 0 24px 40px -14px rgb(42 30 63 / 0.35);
  }

  /* A role: its stage changes. */
  .stage-badge {
    position: absolute;
    left: 258px;
    top: 203px;
    width: 107px;
    height: 20px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.25px;
    font-weight: 700;
    text-transform: uppercase;
    transition:
      opacity 0.35s,
      transform 0.45s cubic-bezier(0.3, 1.3, 0.4, 1);
  }
  .stage-badge.old {
    background: #e4defa;
    color: #2f2466;
  }
  .stage-badge.new {
    background: #ece2f8;
    color: #45236b;
    opacity: 0;
    transform: translateY(8px);
  }
  .stage-badge:global(.gone) {
    opacity: 0;
  }
  .stage-badge.new:global(.on) {
    opacity: 1;
    transform: none;
  }
  .menu {
    position: absolute;
    left: 258px;
    top: 278px;
    width: 109px;
    padding: 5px;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 22px 56px -24px rgb(42 30 63 / 0.34);
    display: flex;
    flex-direction: column;
    font-size: 14px;
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
    transform-origin: top left;
    transition:
      opacity 0.2s,
      transform 0.25s;
  }
  .menu small,
  .menu span {
    padding-inline: 12px;
  }
  .menu small {
    font-size: 12px;
    font-weight: 500;
    line-height: 28px;
    color: var(--app-muted);
  }
  .menu span {
    line-height: 35px;
    border-radius: 18px;
  }
  .menu .pick {
    background: #f3f0fa;
  }
  .menu:global(.on) {
    opacity: 1;
    transform: none;
  }

  /* Insights: a white curtain slides off the Sankey, left to right. */
  .cover {
    position: absolute;
    left: 283px;
    top: 318px;
    width: 1106px;
    height: 444px;
    background: #fff;
    transform-origin: 100% 50%;
  }
