---
import { GUIDE } from "../data";

// The install and demo commands match the README and the install guide (which gives the two pnpm
// steps a line each). "Use it for real" follows the README; the guide splits it between
// install.md and your-data.md. Keep them in step.

type Line = { cmd?: string; out?: string; note?: string };
const tabs: { id: string; label: string; lines: Line[] }[] = [
  {
    id: "install",
    label: "1 · Install",
    lines: [
      { cmd: "git clone https://github.com/waddington/job-application-tracker.git" },
      { cmd: "cd job-application-tracker" },
      { cmd: "uv sync" },
      { cmd: "pnpm --dir frontend install && pnpm --dir frontend build" },
      { out: "✓ built the web UI into frontend/dist" },
    ],
  },
  {
    id: "demo",
    label: "2 · Try it with demo data",
    lines: [
      { note: "# made-up companies and people; needs a new or empty folder" },
      { cmd: "uv run python scripts/seed_demo.py /tmp/jat-demo" },
      { cmd: "uv run jat --data-dir /tmp/jat-demo serve" },
      { out: "→ http://127.0.0.1:8770" },
    ],
  },
  {
    id: "real",
    label: "3 · Use it for real",
    lines: [
      { cmd: "mkdir -p ~/job-search-data && git -C ~/job-search-data init" },
      { cmd: "git -C ~/job-search-data remote add origin <your-private-repo-url>" },
      { cmd: "cp .env.example .env" },
      { note: "# then set JAT_DATA_DIR=~/job-search-data in .env" },
      { cmd: "uv run jat init" },
      { cmd: "uv run jat serve" },
      { out: "→ http://127.0.0.1:8770 (keeps running)" },
      { cmd: "uv run jat push" },
      { out: "✓ snapshots sent to your private repo" },
    ],
  },
];

const needs = [
  { name: "Python 3.12+", why: "the app", href: "https://www.python.org/downloads/" },
  { name: "uv", why: "installs and runs it", href: "https://docs.astral.sh/uv/" },
  { name: "Node.js 22.12+", why: "to build the UI", href: "https://nodejs.org/" },
  { name: "pnpm", why: "to build the UI", href: "https://pnpm.io/" },
  { name: "git", why: "snapshots of your data", href: "https://git-scm.com/" },
  { name: "A private repo", why: "optional, for off-machine backups", href: "https://github.com/new" },
];
---

<section class="section" id="quickstart" aria-labelledby="qs-h">
  <div class="wrap">
    <div class="center head">
      <p class="eyebrow reveal">Quick start</p>
      <h2 class="h2 reveal" id="qs-h">
        Set up in about <span class="serif grad">ten minutes</span>.
      </h2>
      <p class="lede reveal">
        For now there's no installer. With uv and Node.js on your computer, you copy and paste a few
        commands into the Terminal app, once; the <a href={`${GUIDE}install.md`}>install guide</a> lists what
        you need and where to get it. After that it's a web page in your browser. A one-command install and a
        double-click app are on the way.
      </p>
    </div>

    <ul class="needs reveal" aria-label="What you need">
      {needs.map((n) => (
        <li>
          <a href={n.href} rel="noopener">
            <b>{n.name}</b>
            <span>{n.why}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="os reveal">
      <b>Mac or Linux.</b> Windows isn't supported yet; it's next on the roadmap.
    </p>

    <div class="term-wrap reveal" data-tabs>
      <div class="term-glow" aria-hidden="true"></div>
      <div class="term">
        <div class="term-bar">
          <span class="dots" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <div role="tablist" aria-label="Quick start steps">
            {tabs.map((t, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                aria-controls={`panel-${t.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
              >
                {t.label}
              </button>
            ))}
          </div>
        </div>
        {tabs.map((t, i) => (
          <div
            class="panel"
            role="tabpanel"
            id={`panel-${t.id}`}
            aria-labelledby={`tab-${t.id}`}
            hidden={i !== 0}
            data-type
          >
            <button
              type="button"
              class="copy-all"
              data-copy={t.lines
                .filter((l) => l.cmd)
                .map((l) => l.cmd)
                .join("\n")}
              aria-label={`Copy the ${t.label.replace(/^\d · /, "").toLowerCase()} commands`}
            >
              Copy
            </button>
            <div class="pre">
              {t.lines.map((l) =>
                l.cmd ? (
                  <div class="line">
                    <span class="ps">$ </span>
                    <span class="cmd">{l.cmd}</span>
                  </div>
                ) : (
                  <div class={`line out ${l.note ? "note" : "ok"}`}>{l.note ?? l.out}</div>
                ),
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <p class="more reveal">
      The <a href={`${GUIDE}README.md`}>user guide</a> covers the rest: where your data lives, backups and
      restoring, a second computer, your own stages and every command.
    </p>
  </div>
</section>

<style>
  .head {
    margin-bottom: 44px;
  }
  .needs {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    max-width: 1000px;
  }
  .needs a {
    display: grid;
    gap: 2px;
    height: 100%;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    transition:
      border-color 0.3s,
      transform 0.3s var(--ease);
  }
  .needs a:hover {
    border-color: color-mix(in oklab, var(--cyan) 50%, transparent);
    transform: translateY(-3px);
  }
  .needs b {
    font-size: 15px;
  }
  .needs span {
    font-size: 13px;
    color: var(--faint);
  }
  .os {
    text-align: center;
    color: var(--faint);
    font-size: 14px;
    margin: 16px 0 40px;
  }
  .term-wrap {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
  }
  .term-glow {
    position: absolute;
    inset: 20px;
    background: linear-gradient(120deg, var(--brand), var(--violet), var(--cyan));
    filter: blur(70px);
    opacity: 0.35;
    z-index: -1;
  }
  .term {
    /* Always dark, whatever the palette: its own light-on-dark colours. */
    --text: #f2ede4;
    --muted: #a8a196;
    --faint: #7a7368;
    --surface-2: rgb(255 255 255 / 0.07);
    --border: rgb(255 255 255 / 0.1);
    --border-strong: rgb(255 255 255 / 0.16);
    color: var(--text);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--term);
    box-shadow: 0 40px 100px -30px color-mix(in oklab, var(--shadow) 90%, transparent);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 14px;
    background: var(--term-bar);
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }
  .dots {
    display: flex;
    gap: 7px;
    flex: none;
  }
  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff6b6b;
  }
  .dots i:nth-child(2) {
    background: #fcc419;
  }
  .dots i:nth-child(3) {
    background: #51cf66;
  }
  [role="tablist"] {
    display: flex;
    gap: 4px;
  }
  [role="tab"] {
    font: inherit;
    font-size: 14px;
    padding: 6px 14px;
    border-radius: 8px;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
    transition:
      background 0.2s,
      color 0.2s;
  }
  [role="tab"]:hover {
    color: var(--text);
  }
  [role="tab"][aria-selected="true"] {
    background: var(--surface-2);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  .panel {
    position: relative;
  }
  .pre {
    padding: 26px 24px 30px;
    font-family: var(--mono);
    font-size: 14.5px;
    line-height: 1.85;
    overflow-x: auto;
    min-height: 250px;
  }
  .line {
    white-space: pre;
    min-height: 1.85em;
  }
  .ps {
    color: var(--violet);
    user-select: none;
  }
  .cmd {
    color: #e9ecff;
  }
  .note {
    color: var(--faint);
  }
  .ok {
    color: var(--green);
  }
  .line:global(.pending) {
    visibility: hidden;
  }
  .line:global(.typing) .cmd::after {
    content: "▋";
    color: var(--cyan);
    animation: blink 0.8s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .copy-all {
    position: absolute;
    top: 14px;
    right: 14px;
    font: inherit;
    font-size: 13px;
    padding: 5px 12px;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
    color: var(--muted);
    cursor: pointer;
  }
  .copy-all:hover {
    color: var(--text);
  }
  .copy-all:global(.copied) {
    color: var(--green);
    border-color: color-mix(in oklab, var(--green) 50%, transparent);
  }
  .more {
    text-align: center;
    color: var(--muted);
    margin: 40px auto 0;
    max-width: 620px;
  }
  .more a {
    color: var(--accent-soft);
  }
  @media (max-width: 900px) {
    .needs {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 520px) {
    .needs {
      grid-template-columns: 1fr 1fr;
    }
    .pre {
      font-size: 13px;
    }
  }
</style>
