---
// Design concepts only (docs/rfc/website-redesign.md): a floating pill to jump between the concept pages and the
// current site. Round 2 (Kai, 2026-11-12): Espresso, Liquid and Bubbles kept, each with sub-variations.
// Keys 1-9 follow the order shown; 0 is the current site.
interface Props {
  current: string;
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL;
const groups: { name: string; pages: { id: string; title: string }[] }[] = [
  {
    name: "Espresso",
    pages: [
      { id: "1", title: "Espresso (round 1)" },
      { id: "1a", title: "Espresso: line work" },
      { id: "1b", title: "Espresso: grain and light" },
      { id: "1c", title: "Espresso: card mosaic" },
    ],
  },
  {
    name: "Liquid",
    pages: [
      { id: "2", title: "Liquid (round 1)" },
      { id: "2a", title: "Liquid: deeper 3D" },
      { id: "2b", title: "Liquid in Espresso's layout" },
    ],
  },
  {
    name: "Espresso × Liquid",
    pages: [{ id: "6", title: "Espresso × Liquid: warm palette, immersive tour inside the app" }],
  },
  {
    name: "Bubbles",
    pages: [
      { id: "5", title: "Bubbles (round 1)" },
      { id: "5a", title: "Bubbles: calmer" },
      { id: "5b", title: "Bubbles in espresso" },
    ],
  },
];
const order = groups.flatMap((g) => g.pages.map((p) => p.id));
---

<nav class="concept-switcher" aria-label="Design concepts">
  {
    groups.map((g) => (
      <div class="group">
        <span class="label">{g.name}</span>
        {g.pages.map((p) => (
          <a
            href={`${base}concepts/${p.id}/`}
            aria-current={current === p.id ? "page" : undefined}
            title={p.title}
            data-key={String(order.indexOf(p.id) + 1)}
          >
            {p.id}
          </a>
        ))}
      </div>
    ))
  }
  <a href={base} class="current-site" data-key="0" title="The current site">Current</a>
</nav>

<script>
  document.addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const target = e.target as HTMLElement | null;
    if (target && (target.isContentEditable || ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName))) return;
    const link = document.querySelector<HTMLAnchorElement>(`.concept-switcher a[data-key="${e.key}"]`);
    if (link) link.click();
  });
</script>

<style>
  .concept-switcher {
    position: fixed;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    z-index: 2147483000;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    border-radius: 999px;
    font: 500 13px/1 system-ui, sans-serif;
    color: #fff;
    background: rgb(20 20 24 / 0.72);
    border: 1px solid rgb(255 255 255 / 0.16);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.35);
    backdrop-filter: blur(16px) saturate(1.4);
    max-width: calc(100vw - 16px);
    overflow-x: auto;
  }
  .group {
    display: flex;
    align-items: center;
    gap: 2px;
    padding-right: 6px;
    border-right: 1px solid rgb(255 255 255 / 0.16);
  }
  .label {
    padding: 0 6px 0 10px;
    opacity: 0.6;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  a {
    padding: 8px 10px;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    opacity: 0.75;
    white-space: nowrap;
  }
  a:hover {
    opacity: 1;
    background: rgb(255 255 255 / 0.08);
  }
  a[aria-current="page"] {
    opacity: 1;
    background: rgb(255 255 255 / 0.2);
  }
  .current-site {
    margin-left: 2px;
  }
  @media (max-width: 720px) {
    .label {
      display: none;
    }
  }
</style>
