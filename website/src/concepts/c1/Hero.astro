---
// The pinned hero: a browser window with the app in use floats at an angle, turns to face you as you
// scroll, then swings open like a door to show a second window behind it (the same app, light and in
// 简体中文). Never still: a slow drift sits on top of the scroll poses.
import { Image } from "astro:assets";
import AppDemo from "./AppDemo.astro";
import zh from "./shots/today-zh-light.png";
---

<section class="hero" data-c1-tint="ink" data-hero aria-labelledby="c1-hero-h">
  <div class="pin">
    <div class="dots" aria-hidden="true"></div>
    <div class="glow" aria-hidden="true"></div>

    <div class="copy" data-copy>
      <p class="c1-eyebrow">Job application tracker · local-first</p>
      <h1 class="c1-display" id="c1-hero-h">
        Your job search,
        <br />
        kept on your machine.
      </h1>
      <p class="sub c1-soft">
        Every application, recruiter, interview and offer in one place, and a clear list of who to chase
        today. No account, no cloud, no AI, nobody watching.
      </p>
      <div class="ctas">
        <a class="c1-pill c1-pill--copper" href="#get">
          Get started, it's free <span class="c1-arr">→</span>
        </a>
        <a class="c1-pill c1-glass" href="#private">
          Why it's private <span class="c1-arr">↓</span>
        </a>
      </div>
      <p class="fine c1-soft">Free · open source (Apache-2.0) · Mac and Linux</p>
    </div>

    <div class="cap" data-cap="1" aria-hidden="true">
      <p class="c1-eyebrow">The app, in use</p>
      <p>The real thing on made-up data: tick a to-do, drag a card, move a role on.</p>
    </div>
    <div class="cap" data-cap="2" aria-hidden="true">
      <p class="c1-eyebrow">Light or dark · English or 简体中文</p>
      <p>The whole app in both languages, from buttons to dates.</p>
    </div>

    <div class="scene" data-scene>
      <div class="c1-win back" data-back aria-hidden="true">
        <div class="bar">
          <i></i>
          <i></i>
          <i></i>
          <span class="url">
            127.0.0.1 · <span lang="zh-CN">今日</span>
          </span>
        </div>
        <Image src={zh} widths={[1440]} sizes="1000px" alt="" loading="eager" class="zh" />
      </div>
      <div class="c1-win front" data-front>
        <div class="bar">
          <i></i>
          <i></i>
          <i></i>
          <span class="url">
            127.0.0.1<span data-c1-url>/</span>
          </span>
        </div>
        <AppDemo />
        <span class="c1-sr">
          The app's Today page, then the board, a role and the insights Sankey, being used on made-up demo
          data.
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  type Pose = { x: number; y: number; z: number; rx: number; ry: number; rz: number; s: number; o: number };
  type Keys = [number, Pose][];
  const P = (
    x: number,
    y: number,
    z: number,
    rx: number,
    ry: number,
    rz: number,
    s: number,
    o = 1,
  ): Pose => ({
    x,
    y,
    z,
    rx,
    ry,
    rz,
    s,
    o,
  });

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero) run(hero);

  function run(hero: HTMLElement) {
    const front = hero.querySelector<HTMLElement>("[data-front]")!;
    const back = hero.querySelector<HTMLElement>("[data-back]")!;
    const copy = hero.querySelector<HTMLElement>("[data-copy]")!;
    const caps = [...hero.querySelectorAll<HTMLElement>("[data-cap]")];
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const narrow = matchMedia("(max-width: 760px)");

    // x and y in vw / vh, z in px, angles in degrees.
    const wide = {
      front: [
        [0, P(23, 9, 0, 12, -30, -2, 0.8)],
        [0.38, P(0, 2, 0, 2, 0, 0, 1)],
        [0.56, P(0, 2, 0, 2, 0, 0, 1)],
        [0.92, P(-30, 2, 140, 2, -78, 0, 1, 0)],
      ] as Keys,
      back: [
        [0, P(32, -3, -360, 12, -30, -2, 0.78, 0.35)],
        [0.56, P(10, -5, -420, 4, -10, 0, 0.92, 0.55)],
        [0.92, P(0, 2, 0, 2, 0, 0, 1)],
      ] as Keys,
    };
    const small = {
      front: [
        [0, P(4, 17, 0, 16, -18, -2, 0.9)],
        [0.38, P(0, 4, 0, 4, 0, 0, 1)],
        [0.56, P(0, 4, 0, 4, 0, 0, 1)],
        [0.92, P(-40, 4, 120, 4, -80, 0, 1, 0)],
      ] as Keys,
      back: [
        [0, P(8, 10, -300, 16, -18, -2, 0.85, 0.4)],
        [0.56, P(6, -2, -360, 6, -8, 0, 0.92, 0.5)],
        [0.92, P(0, 4, 0, 4, 0, 0, 1)],
      ] as Keys,
    };
    const still = {
      front: [[0, P(21, 8, 0, 8, -20, -1, 0.78)]] as Keys,
      back: [[0, P(28, 1, -300, 8, -20, -1, 0.76, 0.6)]] as Keys,
    };
    const stillSmall = {
      front: [[0, P(0, 14, 0, 8, -10, 0, 0.94)]] as Keys,
      back: [[0, P(6, 8, -260, 8, -10, 0, 0.9, 0.5)]] as Keys,
    };

    const ease = (t: number) => t * t * (3 - 2 * t);
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    function at(keys: Keys, p: number): Pose {
      if (p <= keys[0][0]) return keys[0][1];
      for (let i = 1; i < keys.length; i++) {
        const [p1, b] = keys[i];
        const [p0, a] = keys[i - 1];
        if (p <= p1) {
          const t = ease((p - p0) / (p1 - p0));
          const out = {} as Pose;
          for (const k of Object.keys(a) as (keyof Pose)[]) out[k] = a[k] + (b[k] - a[k]) * t;
          return out;
        }
      }
      return keys[keys.length - 1][1];
    }
    function apply(el: HTMLElement, q: Pose, drift: number[]) {
      const [dx, dy, dz] = drift;
      el.style.transform =
        `translate(-50%, -50%) translate3d(${q.x}vw, calc(${q.y}vh + ${dy}px), ${q.z}px) ` +
        `rotateX(${q.rx + dx}deg) rotateY(${q.ry + dz}deg) rotateZ(${q.rz}deg) scale(${q.s})`;
      el.style.opacity = String(q.o);
    }

    let progress = 0;
    let visible = true;
    function measure() {
      const r = hero.getBoundingClientRect();
      const span = r.height - innerHeight;
      progress = span > 0 ? clamp(-r.top / span) : 0;
    }
    function frame(t: number) {
      const motion = !reduce.matches;
      const set = motion ? (narrow.matches ? small : wide) : narrow.matches ? stillSmall : still;
      const p = motion ? progress : 0;
      const drift = motion
        ? [Math.sin(t / 2600) * 1.6, Math.sin(t / 2100) * 7, Math.sin(t / 3300) * 2.4]
        : [0, 0, 0];
      apply(front, at(set.front, p), drift);
      apply(back, at(set.back, p), [drift[0] * 0.6, -drift[1] * 0.6, drift[2] * 0.6]);
      // Front turns about its left edge when it swings away.
      front.style.transformOrigin = p > 0.56 ? "0% 50%" : "50% 50%";
      copy.style.opacity = String(1 - clamp(p / 0.2));
      copy.style.transform = `translateY(${-60 * clamp(p / 0.3)}px)`;
      copy.style.visibility = p > 0.22 ? "hidden" : "visible";
      // Captions fade out again as the hero scrolls away, so their light text never sits on a light tint.
      const exit = clamp((hero.getBoundingClientRect().bottom - innerHeight * 0.55) / (innerHeight * 0.3));
      const c1 = motion ? clamp((p - 0.36) / 0.06) * (1 - clamp((p - 0.6) / 0.06)) : 0;
      const c2 = motion ? clamp((p - 0.86) / 0.06) * exit : 0;
      caps[0].style.opacity = String(c1);
      caps[1].style.opacity = String(c2);
      caps[0].style.transform = `translateY(${(1 - c1) * 16}px)`;
      caps[1].style.transform = `translateY(${(1 - c2) * 16}px)`;
      if (motion && visible) requestAnimationFrame(frame);
    }
    addEventListener("scroll", measure, { passive: true });
    addEventListener("resize", measure);
    new IntersectionObserver(([e]) => {
      const was = visible;
      visible = e.isIntersecting;
      if (visible && !was) requestAnimationFrame(frame);
    }).observe(hero);
    reduce.addEventListener("change", () => requestAnimationFrame(frame));
    measure();
    requestAnimationFrame(frame);
  }
</script>

<style>
  .hero {
    position: relative;
    height: 380vh;
    color: #f3ece2;
  }
  .pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    perspective: 1800px;
    perspective-origin: 50% 40%;
  }
  .dots {
    position: absolute;
    inset: -40px;
    background-image: radial-gradient(circle, rgb(214 196 178 / 0.2) 1.1px, transparent 1.7px);
    background-size: 16px 16px;
    mask-image: radial-gradient(ellipse 70% 60% at 62% 58%, #000 10%, transparent 75%);
    animation: c1-drift 28s linear infinite;
  }
  @keyframes c1-drift {
    to {
      transform: translate(16px, 16px);
    }
  }
  .glow {
    position: absolute;
    left: 30%;
    top: 30%;
    width: 70vw;
    height: 60vh;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(196 122 72 / 0.36), rgb(120 70 40 / 0.12) 55%, transparent);
    filter: blur(30px);
    animation: c1-breathe 9s ease-in-out infinite alternate;
  }
  @keyframes c1-breathe {
    to {
      opacity: 0.6;
      transform: translate(-6%, 4%) scale(1.08);
    }
  }
  .copy {
    position: absolute;
    z-index: 5;
    left: max(6vw, 24px);
    top: 50%;
    margin-top: -170px;
    width: min(580px, 42vw);
  }
  .copy .c1-display {
    font-size: clamp(40px, 4.4vw, 64px);
  }
  .sub {
    margin: 22px 0 30px;
    font-size: 18px;
    font-weight: 300;
    max-width: 30em;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ctas .c1-glass {
    color: inherit;
  }
  .fine {
    margin: 22px 0 0;
    font-size: 13.5px;
  }
  .cap {
    position: absolute;
    z-index: 5;
    left: max(6vw, 24px);
    top: 96px;
    max-width: 420px;
    opacity: 0;
    font-size: 17px;
    font-weight: 300;
    line-height: 1.45;
  }
  .cap .c1-eyebrow {
    margin-bottom: 10px;
  }
  .cap p {
    margin: 0;
  }
  .scene {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .c1-win {
    position: absolute;
    left: 50%;
    top: 57%;
    width: min(1020px, 82vw, calc((100svh - 260px) * 1.52));
    border-radius: 18px;
    overflow: hidden;
    background: #1b1b1b;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 2px 0 rgb(255 255 255 / 0.06) inset,
      0 50px 120px -30px rgb(0 0 0 / 0.85),
      0 30px 60px -40px rgb(196 122 72 / 0.5);
    will-change: transform, opacity;
    backface-visibility: hidden;
  }
  .back {
    background: #f4f4f4;
  }
  .bar {
    height: 38px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 14px;
    background: linear-gradient(#2c2622, #231e1a);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }
  .back .bar {
    background: linear-gradient(#ece6de, #e1d9cf);
    border-bottom-color: rgb(0 0 0 / 0.06);
  }
  .bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.16);
  }
  .back .bar i {
    background: rgb(0 0 0 / 0.14);
  }
  .bar i:first-child {
    background: var(--c1-copper);
  }
  .url {
    margin: 0 auto;
    padding: 4px 16px;
    min-width: 40%;
    text-align: center;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.07);
    font:
      12px/1.3 "JetBrains Mono Variable",
      ui-monospace,
      monospace;
    color: rgb(243 236 226 / 0.7);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .back .url {
    background: rgb(0 0 0 / 0.06);
    color: #5b4d42;
  }
  .zh {
    width: 100%;
    height: auto;
  }

  @media (max-width: 760px) {
    .hero {
      height: 300vh;
    }
    .copy {
      left: 20px;
      right: 20px;
      top: 92px;
      margin: 0;
      width: auto;
    }
    .copy .c1-display {
      font-size: 36px;
    }
    .sub {
      margin: 14px 0 18px;
      font-size: 15.5px;
    }
    .fine {
      display: none;
    }
    .c1-pill {
      padding: 11px 18px;
      font-size: 14px;
    }
    .c1-win {
      top: 64%;
      width: 92vw;
      border-radius: 12px;
    }
    .bar {
      height: 26px;
      padding: 0 10px;
      gap: 5px;
    }
    .bar i {
      width: 7px;
      height: 7px;
    }
    .url {
      font-size: 9.5px;
      padding: 2px 10px;
    }
    .cap {
      left: 20px;
      right: 20px;
      top: 96px;
      bottom: auto;
      font-size: 15px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }
    .pin {
      position: relative;
      min-height: 760px;
    }
    .dots,
    .glow {
      animation: none;
    }
  }
  @media (prefers-reduced-motion: reduce) and (max-width: 760px) {
    .pin {
      min-height: 820px;
    }
  }
</style>
