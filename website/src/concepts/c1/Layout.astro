---
// Concept 1, "Espresso" (docs/rfc/website-redesign.md): its own shell, so it neither inherits nor
// changes the current site's global CSS. Everything here is prefixed `c1-`.
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import Switcher from "../Switcher.astro";
---

<!doctype html>
<html lang="en" class="c1-html" data-tint="ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark light" />
    <title>Concept 1 · Espresso · Job Application Tracker</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body class="c1-body">
    <!-- The page tint: five fixed layers, one faded in per section (opacity only). -->
    <div class="c1-tints" aria-hidden="true">
      <i data-t="ink"></i>
      <i data-t="paper"></i>
      <i data-t="taupe"></i>
      <i data-t="cream"></i>
      <i data-t="espresso"></i>
    </div>
    <slot />
    <Switcher current={1} />
    <script>
      // Which section has the middle of the screen sets the page tint (and so the glass chrome's tint).
      const root = document.documentElement;
      const sections = document.querySelectorAll<HTMLElement>("[data-c1-tint]");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) root.dataset.tint = (e.target as HTMLElement).dataset.c1Tint;
          }
        },
        { rootMargin: "-50% 0px -50% 0px" },
      );
      sections.forEach((s) => io.observe(s));
    </script>
  </body>
</html>

<style is:global>
  .c1-html {
    --c1-ink: #0d0b09;
    --c1-paper: #f6f3ee;
    --c1-taupe: #c3b5a5;
    --c1-cream: #eee3d1;
    --c1-espresso: #2a1c14;
    --c1-espresso-deep: #1d130d;
    --c1-copper: #c47a48;
    --c1-copper-hi: #e0a072;
    --c1-grey: #8c8781;
    --c1-ease: cubic-bezier(0.22, 0.61, 0.24, 1);
    --c1-fg: #f3ece2;
    --c1-fg-soft: rgb(243 236 226 / 0.62);
    --c1-glass-tint: 255 255 255;
    --c1-glass-a: 0.1;
    --c1-glass-line: rgb(255 255 255 / 0.22);
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
    background: var(--c1-ink);
  }
  .c1-html[data-tint="paper"],
  .c1-html[data-tint="taupe"],
  .c1-html[data-tint="cream"] {
    --c1-fg: #241912;
    --c1-fg-soft: rgb(36 25 18 / 0.6);
    --c1-glass-a: 0.42;
    --c1-glass-line: rgb(255 255 255 / 0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    .c1-html {
      scroll-behavior: auto;
    }
  }
  .c1-body {
    margin: 0;
    color: var(--c1-fg);
    font-family: "Inter Variable", system-ui, sans-serif;
    font-weight: 400;
    font-size: 17px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
    transition: color 0.6s var(--c1-ease);
  }
  .c1-body *,
  .c1-body *::before,
  .c1-body *::after {
    box-sizing: border-box;
  }
  .c1-body img {
    display: block;
    max-width: 100%;
  }
  .c1-body a {
    color: inherit;
  }
  .c1-tints {
    position: fixed;
    inset: 0;
    z-index: -1;
  }
  .c1-tints i {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s var(--c1-ease);
  }
  .c1-tints [data-t="ink"] {
    background: var(--c1-ink);
    opacity: 1;
  }
  .c1-tints [data-t="paper"] {
    background: var(--c1-paper);
  }
  .c1-tints [data-t="taupe"] {
    background: var(--c1-taupe);
  }
  .c1-tints [data-t="cream"] {
    background: var(--c1-cream);
  }
  .c1-tints [data-t="espresso"] {
    background: var(--c1-espresso-deep);
  }
  .c1-html[data-tint="paper"] .c1-tints [data-t="paper"],
  .c1-html[data-tint="taupe"] .c1-tints [data-t="taupe"],
  .c1-html[data-tint="cream"] .c1-tints [data-t="cream"],
  .c1-html[data-tint="espresso"] .c1-tints [data-t="espresso"] {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .c1-tints i,
    .c1-body {
      transition: none;
    }
  }

  /* Shared pieces: the eyebrow, display type, glass chrome. */
  .c1-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    font: 500 11.5px/1.2 "JetBrains Mono Variable", ui-monospace, monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.78;
  }
  .c1-eyebrow::before {
    content: "";
    width: 7px;
    height: 7px;
    background: var(--c1-copper);
    flex: none;
  }
  .c1-display {
    font-weight: 300;
    font-size: clamp(38px, 5vw, 66px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0;
    text-wrap: balance;
  }
  .c1-h2 {
    font-weight: 300;
    font-size: clamp(32px, 3.6vw, 50px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0;
    text-wrap: balance;
  }
  .c1-soft {
    color: var(--c1-fg-soft);
  }
  .c1-glass {
    position: relative;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.22), rgb(255 255 255 / 0) 55%),
      rgb(var(--c1-glass-tint) / var(--c1-glass-a));
    border: 1px solid var(--c1-glass-line);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 10px 30px -12px rgb(0 0 0 / 0.35);
    backdrop-filter: blur(22px) saturate(1.5);
    -webkit-backdrop-filter: blur(22px) saturate(1.5);
  }
  .c1-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 22px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.4s var(--c1-ease);
  }
  .c1-pill:hover {
    transform: translateY(-2px);
  }
  .c1-pill--copper {
    color: #1b110b;
    background: linear-gradient(180deg, var(--c1-copper-hi), var(--c1-copper));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.45),
      0 12px 30px -10px rgb(196 122 72 / 0.7);
  }
  .c1-pill .c1-arr {
    transition: transform 0.4s var(--c1-ease);
  }
  .c1-pill:hover .c1-arr {
    transform: translateX(3px);
  }
  .c1-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .c1-body :focus-visible {
    outline: 2px solid var(--c1-copper);
    outline-offset: 3px;
  }
</style>
