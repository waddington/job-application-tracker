---
// Concept 5a, "Bubbles: calmer" (docs/rfc/website-redesign.md): its own document, so nothing from the current
// site's global CSS leaks in (and nothing here leaks out: every class is prefixed c5-).
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "./c5.css";
import { DESCRIPTION } from "../../data";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="c5-html">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Concept 5a: Bubbles: calmer · Job Application Tracker</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="c5-body">
    <slot />
  </body>
</html>
