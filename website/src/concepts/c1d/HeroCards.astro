---
// The hero's texture (from 1c): columns of small application cards in stage colours, drifting slowly up behind
// the browser window. The colours are the theme's --c1-t0 to --c1-t4. Transform only.
const rnd = (i: number) => (((Math.sin(i * 12.9898) * 43758.5453) % 1) + 1) % 1;
const cols = Array.from({ length: 8 }, (_, c) =>
  Array.from({ length: 9 }, (_, k) => ({
    tone: Math.min(4, Math.floor(rnd(c * 31 + k) * 5)),
    w: 60 + Math.round(rnd(c * 7 + k * 3) * 35),
  })),
);
---

<div class="c1d-cards" aria-hidden="true">
  {cols.map((col, c) => (
    <div class="col" style={`--dur:${38 + (c % 3) * 9}s;--delay:${-c * 4.3}s`}>
      {[0, 1].map(() => (
        <div class="stack">
          {col.map((m) => (
            <span class="mc" style={`--tone:var(--c1-t${m.tone});--w:${m.w}%`}>
              <b />
            </span>
          ))}
        </div>
      ))}
    </div>
  ))}
</div>

<style>
  .c1d-cards {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 14px;
    padding: 0 14px;
    overflow: hidden;
    opacity: 0.2;
    mask-image: linear-gradient(90deg, transparent 0%, transparent 38%, #000 78%);
  }
  :global([data-theme="liquid"]) .c1d-cards {
    opacity: 0.32;
  }
  /* On 1f's pale hero the pastel cards show at full strength, with a plum title line and a soft edge. */
  :global([data-theme="bubbles"]) .c1d-cards {
    opacity: 0.85;
  }
  :global([data-theme="bubbles"]) .mc {
    box-shadow:
      inset 0 0 0 1px rgb(42 30 63 / 0.06),
      0 8px 20px -12px rgb(42 30 63 / 0.25);
  }
  :global([data-theme="bubbles"]) .mc b {
    background: rgb(42 30 63 / 0.18);
  }
  .col {
    animation: c1d-up var(--dur) linear infinite;
    animation-delay: var(--delay);
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-bottom: 14px;
  }
  .mc {
    position: relative;
    display: block;
    width: var(--w);
    height: 46px;
    border-radius: 10px;
    background: var(--tone);
  }
  .mc b {
    position: absolute;
    left: 12px;
    top: 14px;
    height: 6px;
    width: 46%;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.45);
  }
  @keyframes c1d-up {
    to {
      transform: translateY(-50%);
    }
  }
  @media (max-width: 760px) {
    .c1d-cards {
      grid-template-columns: repeat(5, 1fr);
      gap: 8px;
      mask-image: linear-gradient(180deg, transparent 0%, transparent 48%, #000 85%);
    }
    .col:nth-child(n + 6) {
      display: none;
    }
    .mc {
      height: 30px;
      border-radius: 7px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .col {
      animation: none;
    }
  }
</style>
