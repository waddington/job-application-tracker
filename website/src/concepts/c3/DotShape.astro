---
// Concept 3 (Paper): the graph-paper dot grid drawing one of our shapes: a board's columns, a calendar month, or the
// funnel of a search. Dots on the shape are ink, a few are green and breathe; the rest are faint grid.
interface Props {
  shape: "board" | "calendar" | "funnel";
  label: string;
}
const { shape, label } = Astro.props;
const cols = 28;
const rows = 18;
const gap = 10;

function kind(x: number, y: number): "" | "on" | "hot" {
  if (shape === "board") {
    // Four columns of different heights, a card picked up in the second.
    const heights = [9, 14, 5, 11];
    const col = Math.floor((x - 2) / 6);
    const inCol = (x - 2) % 6 < 5 && col >= 0 && col < 4;
    if (!inCol || y < 2) return "";
    if (y - 2 < heights[col]) {
      if (col === 1 && y >= 5 && y <= 7) return "hot";
      return (y - 2) % 4 === 3 ? "" : "on";
    }
    return "";
  }
  if (shape === "calendar") {
    // A month: 7 days by 5 weeks, each day a 3 x 2 block, interview days in green.
    if (x < 3 || y < 3) return "";
    const dx = x - 3;
    const dy = y - 3;
    const day = Math.floor(dx / 3.4);
    const wk = Math.floor(dy / 3);
    if (day > 6 || wk > 4 || dx % 3.4 > 2.4 || dy % 3 > 1.5) return "";
    const n = wk * 7 + day;
    return [9, 12, 17, 23, 26].includes(n) ? "hot" : "on";
  }
  // A funnel: wide on the left, narrowing to the few that reached an offer.
  const half = Math.max(1, 8 - Math.floor(x / 3.2));
  const mid = 9;
  if (x < 2 || x > 25) return "";
  if (Math.abs(y - mid) <= half) return x > 21 ? "hot" : "on";
  return "";
}
const dots: { x: number; y: number; k: string; d: number }[] = [];
for (let y = 0; y < rows; y++)
  for (let x = 0; x < cols; x++) dots.push({ x, y, k: kind(x, y), d: ((x * 7 + y * 13) % 17) / 10 });
---

<svg class="c3-dots" viewBox={`0 0 ${cols * gap} ${rows * gap}`} role="img" aria-label={label}>
  {
    dots.map((d) => (
      <circle
        cx={d.x * gap + gap / 2}
        cy={d.y * gap + gap / 2}
        r={d.k ? 2.6 : 1.1}
        class={d.k}
        style={d.k === "hot" ? `animation-delay:${d.d}s` : undefined}
      />
    ))
  }
</svg>
