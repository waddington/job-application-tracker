---
// Concept 3 (Paper): the app being used, inside the front browser window. The app is laid out at its real size
// (1440 x 900, like the screenshots it is built around) and scaled to fit; the sidebar, header, board, a to-do tick
// and a stage change are HTML so they can move, the long pages are real screenshots (made-up demo data).
import { Image } from "astro:assets";
import today from "./shots/today-content.png";
import role from "./shots/role-content.png";
import insights from "./shots/insights-content.png";

const nav: { id: string; label: string; icon: string; group?: string }[] = [
  { id: "today", label: "Today", icon: "M4 11l8-7 8 7v9h-5v-6h-6v6H4z" },
  { id: "roles", label: "Roles", icon: "M4 6h3M4 12h3M4 18h3M10 6h10M10 12h10M10 18h10", group: "Your applications" },
  { id: "applications", label: "Applications", icon: "M4 8h16v11H4zM9 8V5h6v3M4 13h16" },
  { id: "interviews", label: "Interviews", icon: "M4 6h16v14H4zM4 10h16M8 3v5M16 3v5" },
  { id: "offers", label: "Offers", icon: "M3 7h18v11H3zM12 10a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5" },
  {
    id: "recruiters",
    label: "Recruiters",
    icon: "M9 4a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7M3 20c0-3.5 2.7-6 6-6s6 2.5 6 6M16 4.5a3.5 3.5 0 0 1 0 7M21 20c0-3-1.5-5-4-5.7",
    group: "People and companies",
  },
  { id: "companies", label: "Companies", icon: "M5 3h14v18H5zM9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2" },
  { id: "documents", label: "Documents", icon: "M7 3h7l5 5v13H7zM14 3v5h5", group: "Files and notes" },
  { id: "notes", label: "Notes", icon: "M5 3h14v18H5zM9 8h6M9 12h6M9 16h4" },
  { id: "insights", label: "Insights", icon: "M3 7c8 0 10 10 18 10M3 17c8 0 10-10 18-10", group: "Review" },
  { id: "timeline", label: "Timeline", icon: "M3 17l5-6 4 3 8-9" },
];

type Card = { id?: string; company: string; role: string; when: string; extra?: string; late?: boolean };
const columns: { id: string; name: string; cards: Card[] }[] = [
  { id: "interested", name: "Interested", cards: [{ company: "Northwind Traders", role: "Lead Engineer", when: "2 days ago" }] },
  {
    id: "applied",
    name: "Applied",
    cards: [
      { id: "drag", company: "Adventure Works", role: "Backend Engineer (Go)", when: "3 days ago" },
      { company: "Coho Winery", role: "Full-stack Engineer", when: "9 days ago", extra: "★ Jordan Lee" },
      { company: "Fabrikam", role: "Staff Platform Engineer", when: "12 days ago" },
      { company: "Coho Winery", role: "Senior Full-stack Engineer", when: "2 weeks ago", late: true },
    ],
  },
  { id: "screen", name: "Screen", cards: [] },
  {
    id: "interviewing",
    name: "Interviewing",
    cards: [
      {
        id: "contoso",
        company: "Contoso",
        role: "Senior Backend Engineer",
        when: "9 days ago",
        extra: "Alex Morgan",
      },
    ],
  },
  { id: "final", name: "Final", cards: [] },
];
---

<div class="c3-app" data-live-app aria-hidden="true">
  <header class="c3-app-top">
    <span class="c3-app-brand">
      <svg viewBox="0 0 24 24" width="22" height="22"
        ><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle><circle
          cx="12"
          cy="12"
          r="4.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"></circle><circle cx="12" cy="12" r="1.4" fill="currentColor"></circle></svg
      >
      Job Application Tracker
    </span>
    <span class="c3-app-new">+ &nbsp;New application</span>
    <span class="c3-app-search">Search everything <kbd>/</kbd></span>
    <span class="c3-app-lang">English</span>
  </header>

  <aside class="c3-app-side">
    <i class="c3-app-hl" data-hl></i>
    {
      nav.map((n) => (
        <>
          {n.group && (
            <>
              <hr />
              <p class="c3-app-group">{n.group}</p>
            </>
          )}
          <span class="c3-app-nav" data-nav={n.id} class:list={{ on: n.id === "today" }}>
            <svg viewBox="0 0 24 24" width="18" height="18">
              <path d={n.icon} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            </svg>
            {n.label}
          </span>
        </>
      ))
    }
    <p class="c3-app-foot"><b></b> Connected<br />Local-first: your data stays on this machine</p>
  </aside>

  <main class="c3-app-main">
    <section class="c3-scene on" data-scene="today">
      <div class="c3-scroll" data-scroll>
        <Image src={today} alt="" widths={[1210]} loading="eager" />
        <i class="c3-tick" data-tick></i>
        <i class="c3-strike" data-strike></i>
      </div>
    </section>

    <section class="c3-scene" data-scene="board">
      <div class="c3-board-head">
        <h3>
          <svg viewBox="0 0 24 24" width="26" height="26"
            ><path d="M4 8h16v11H4zM9 8V5h6v3M4 13h16" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg
          >
          Applications <small>11</small>
        </h3>
        <span class="c3-seg"><span>List</span><span class="on">Board</span></span>
      </div>
      <div class="c3-board-filters">
        <span style="width:300px">Search company, role, recruiter…</span><span style="width:240px">All stages</span><span
          style="width:140px">Any route</span
        ><span style="width:200px">Any agency</span>
      </div>
      <div class="c3-board" data-board>
        {
          columns.map((c) => (
            <div class={`c3-col c3-col-${c.id}`} data-col={c.id}>
              <p class="c3-col-head">
                <span class={`c3-badge b-${c.id}`}>{c.name}</span>
                <span data-count>{c.cards.length}</span>
              </p>
              <div class="c3-col-cards">
                {c.cards.map((k) => (
                  <div class:list={["c3-kcard", { late: k.late }]} data-card={k.id}>
                    <b>{k.company}</b>
                    <span>{k.role}</span>
                    {k.id === "contoso" && <em class="c3-round">Round 3 · System design test · Sat 14 Nov</em>}
                    <small>
                      <span>{k.when}</span>
                      {k.extra && <span>{k.extra}</span>}
                    </small>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
      <p class="c3-toast" data-toast>Moved to Screen <b>Undo</b></p>
    </section>

    <section class="c3-scene" data-scene="role">
      <div class="c3-scroll" data-scroll>
        <Image src={role} alt="" widths={[1210]} loading="eager" />
        <i class="c3-stage" data-stage>Final</i>
        <div class="c3-menu" data-menu>
          <span>Screen</span><span class="cur">Interviewing</span><span data-pick>Final</span><span>Offer</span><span
            >Rejected</span
          ><span>Withdrawn</span>
        </div>
      </div>
    </section>

    <section class="c3-scene" data-scene="insights">
      <Image src={insights} alt="" widths={[1210]} loading="eager" />
      <i class="c3-wipe" data-wipe></i>
    </section>
  </main>

  <div class="c3-cursor" data-cursor>
    <i class="c3-ripple" data-ripple></i>
    <svg viewBox="0 0 24 24" width="26" height="26"
      ><path
        d="M4 2.5l15 10.2-6.6 1.1 3.9 7.3-3 1.5-3.8-7.4L4.6 19.6z"
        fill="#1d1712"
        stroke="#fff"
        stroke-width="1.5"
        stroke-linejoin="round"></path></svg
    >
  </div>
</div>

<script>
  // The app being used: a loop of small scenes, played only while the window is on screen. Positions are in the
  // app's own 1440 x 900 space (offsetLeft/Top ignore the 3D transforms around it).
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce) document.querySelectorAll<HTMLElement>("[data-live-app]").forEach(play);

  function play(app: HTMLElement) {
    const $ = <T extends HTMLElement>(s: string) => app.querySelector<T>(s)!;
    const cursor = $("[data-cursor]");
    const ripple = $("[data-ripple]");
    const hl = $("[data-hl]");
    const ease = "cubic-bezier(.5,0,.2,1)";
    const MAIN = { x: 230, y: 56 };
    let pos = { x: 760, y: 520 };
    let visible = false;
    let wake: (() => void) | null = null;

    const gate = () =>
      visible && !document.hidden ? Promise.resolve() : new Promise<void>((r) => (wake = r));
    const sleep = async (ms: number) => {
      await gate();
      await new Promise((r) => setTimeout(r, ms));
      await gate();
    };
    const setVisible = (v: boolean) => {
      visible = v;
      app.classList.toggle("paused", !v);
      if (v && !document.hidden && wake) {
        wake();
        wake = null;
      }
    };
    new IntersectionObserver(([e]) => setVisible(e.isIntersecting), { threshold: 0.15 }).observe(app);
    document.addEventListener("visibilitychange", () => setVisible(visible));

    // Where an element sits in the app, ignoring transforms.
    function at(el: HTMLElement) {
      let x = 0;
      let y = 0;
      let n: HTMLElement | null = el;
      while (n && n !== app) {
        x += n.offsetLeft;
        y += n.offsetTop;
        n = n.offsetParent as HTMLElement | null;
      }
      return { x, y, w: el.offsetWidth, h: el.offsetHeight };
    }

    function tween(el: HTMLElement, frames: Keyframe[], ms: number, easing = ease) {
      const a = el.animate(frames, { duration: ms, easing, fill: "forwards" });
      return a.finished.then(() => {
        const last = frames[frames.length - 1];
        for (const [k, v] of Object.entries(last)) if (k !== "offset") el.style.setProperty(k, String(v));
        a.cancel();
      });
    }

    async function move(x: number, y: number, ms = 900) {
      await gate();
      const from = `translate(${pos.x}px, ${pos.y}px)`;
      pos = { x, y };
      await tween(cursor, [{ transform: from }, { transform: `translate(${x}px, ${y}px)` }], ms);
    }
    const moveTo = (el: HTMLElement, dx = 0.5, dy = 0.5, ms?: number, scroll = 0) => {
      const r = at(el);
      return move(r.x + r.w * dx, r.y + r.h * dy - scroll, ms);
    };

    async function click() {
      await gate();
      cursor.animate([{ scale: 1 }, { scale: 0.86 }, { scale: 1 }], { duration: 260, easing: ease });
      ripple.animate(
        [
          { transform: "translate(-50%,-50%) scale(.2)", opacity: 0.55 },
          { transform: "translate(-50%,-50%) scale(1.6)", opacity: 0 },
        ],
        { duration: 600, easing: "ease-out" },
      );
      await new Promise((r) => setTimeout(r, 220));
    }

    let scene = "today";
    async function go(id: string, how: "slide" | "fade" = "slide") {
      await gate();
      const from = $(`[data-scene="${scene}"]`);
      const to = $(`[data-scene="${id}"]`);
      const item = $(`[data-nav="${id === "board" || id === "role" ? "applications" : id}"]`);
      app.querySelectorAll(".c3-app-nav.on").forEach((n) => n.classList.remove("on"));
      item.classList.add("on");
      tween(hl, [{ transform: `translateY(${item.offsetTop}px)` }], 420);
      to.classList.add("on");
      const out = how === "slide" ? "translateX(-6%)" : "translateY(0)";
      const inn = how === "slide" ? "translateX(8%)" : "translateY(12px)";
      from.animate([{ opacity: 1, transform: "none" }, { opacity: 0, transform: out }], {
        duration: 520,
        easing: ease,
      });
      await tween(
        to,
        [
          { opacity: 0, transform: inn },
          { opacity: 1, transform: "none" },
        ],
        620,
      );
      from.classList.remove("on");
      scene = id;
    }

    async function scrollTo(scroller: HTMLElement, y: number, ms: number) {
      await gate();
      await tween(scroller, [{ transform: `translateY(${-y}px)` }], ms, "cubic-bezier(.35,0,.15,1)");
    }

    const boardHTML = $("[data-board]").innerHTML;
    function reset() {
      $("[data-board]").innerHTML = boardHTML;
      app.querySelectorAll<HTMLElement>("[data-scroll]").forEach((s) => (s.style.transform = ""));
      for (const s of ["[data-tick]", "[data-strike]", "[data-stage]", "[data-menu]", "[data-toast]", "[data-wipe]"])
        $(s).removeAttribute("style");
    }

    async function loop() {
      for (;;) {
        // 1. Today: read down the page, tick a to-do.
        await sleep(1400);
        await move(700, 470, 1100);
        const today = $<HTMLElement>('[data-scene="today"] [data-scroll]');
        await scrollTo(today, 520, 2200);
        await sleep(300);
        await move(MAIN.x + 55, MAIN.y + 831 - 520, 900);
        await click();
        tween($("[data-tick]"), [{ transform: "scale(0)" }, { transform: "scale(1)" }], 260);
        await tween($("[data-strike]"), [{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }], 420);
        await sleep(900);

        // 2. The board: open it, drag a card from Applied to Screen.
        await moveTo($('[data-nav="applications"]'), 0.3, 0.5, 1000);
        await click();
        await go("board");
        await sleep(500);
        const card = $<HTMLElement>('[data-card="drag"]');
        const target = $<HTMLElement>('[data-col="screen"] .c3-col-cards');
        await moveTo(card, 0.45, 0.4, 900);
        await gate();
        card.classList.add("lifted");
        const c = at(card);
        const t = at(target);
        const dx = t.x - c.x;
        const dy = t.y - c.y;
        const grab = { ...pos };
        tween(card, [{ transform: "translate(0,0) rotate(0)" }, { transform: `translate(${dx}px, ${dy}px) rotate(2deg)` }], 1100);
        await move(grab.x + dx, grab.y + dy, 1100);
        // Drop: the card joins the Screen column; the Applied cards close the gap.
        const rest = [...card.parentElement!.children].filter((n) => n !== card) as HTMLElement[];
        const before = rest.map((n) => n.offsetTop);
        target.append(card);
        card.classList.remove("lifted");
        card.style.transform = "";
        card.animate([{ transform: "rotate(2deg) scale(1.03)" }, { transform: "none" }], { duration: 300, easing: ease });
        rest.forEach((n, i) =>
          n.animate([{ transform: `translateY(${before[i] - n.offsetTop}px)` }, { transform: "none" }], {
            duration: 420,
            easing: ease,
          }),
        );
        app.querySelector<HTMLElement>('[data-col="applied"] [data-count]')!.textContent = "3";
        app.querySelector<HTMLElement>('[data-col="screen"] [data-count]')!.textContent = "1";
        tween($("[data-toast]"), [{ opacity: 0, transform: "translate(-50%, 12px)" }, { opacity: 1, transform: "translate(-50%, 0)" }], 360);
        await sleep(1500);
        tween($("[data-toast]"), [{ opacity: 0, transform: "translate(-50%, 12px)" }], 300);

        // 3. A role: open Contoso, move it to Final, read down the page.
        await moveTo($('[data-card="contoso"]'), 0.4, 0.3, 1000);
        await click();
        await go("role");
        await sleep(700);
        await move(MAIN.x + 70, MAIN.y + 187, 900);
        await click();
        await tween($("[data-menu]"), [{ opacity: 0, transform: "translateY(-6px)" }, { opacity: 1, transform: "none" }], 240);
        const pick = $("[data-pick]");
        await moveTo(pick, 0.3, 0.5, 600);
        pick.classList.add("hover");
        await click();
        pick.classList.remove("hover");
        tween($("[data-menu]"), [{ opacity: 0 }], 180);
        await tween($("[data-stage]"), [{ opacity: 0, transform: "scale(.7)" }, { opacity: 1, transform: "scale(1)" }], 300);
        await sleep(900);
        await move(900, 640, 900);
        const roleScroll = $<HTMLElement>('[data-scene="role"] [data-scroll]');
        await scrollTo(roleScroll, 640, 2000);
        await sleep(600);
        await scrollTo(roleScroll, 1500, 2400);
        await sleep(700);

        // 4. Insights: the Sankey draws in.
        await moveTo($('[data-nav="insights"]'), 0.3, 0.5, 1100);
        await click();
        $("[data-wipe]").style.transform = "scaleX(1)";
        await go("insights", "fade");
        await tween($("[data-wipe]"), [{ transform: "scaleX(1)" }, { transform: "scaleX(0)" }], 1800, "cubic-bezier(.6,0,.2,1)");
        await move(760, 500, 1400);
        await sleep(1800);

        // 5. Back to Today, and round again.
        await moveTo($('[data-nav="today"]'), 0.3, 0.5, 1000);
        await click();
        reset();
        await go("today", "fade");
      }
    }

    cursor.style.transform = `translate(${pos.x}px, ${pos.y}px)`;
    app.classList.add("playing");
    loop();
  }
</script>
