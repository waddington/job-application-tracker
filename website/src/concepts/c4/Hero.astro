---
// The hero: a browser window built in CSS 3D over a glowing floor, drifting and turning with scroll.
// The app inside is being used (hero.ts): Today (a to-do ticked) → the board (a card dragged from
// Applied to Screen) → insights (a flow hovered) → back to Today. Everything inside the window is
// laid out in the screenshots' own pixels (1440 × 900) through the --u unit, so it scales as one.
import { Image } from "astro:assets";
import chrome from "./shots/chrome.png";
import todayFull from "./shots/today-full.png";
import board from "./shots/board.png";
import insights from "./shots/insights.png";
---

<section class="c4-hero" id="top" data-tint="navy">
  <canvas class="c4-hero-flow" data-c4-flow="hero" aria-hidden="true"></canvas>

  <div class="c4-hero-copy">
    <p class="c4-eyebrow">A private job application tracker</p>
    <h1 class="c4-display">Your whole job search, kept on your own machine.</h1>
    <p class="c4-lede">
      Track every application, recruiter, interview round, follow-up and offer. Free and open source. No AI,
      no cloud, no account, nobody watching.
    </p>
    <div class="c4-ctas">
      <a class="c4-btn c4-btn-solid" href="#quickstart">
        Get started, it's free
      </a>
      <a class="c4-btn c4-glass" href="#journey">
        Follow a search
      </a>
    </div>
  </div>

  <div class="c4-hero-stage" data-c4-stage>
    <div class="c4-floor" aria-hidden="true">
      <i></i>
    </div>
    <div class="c4-rig" data-c4-rig>
      <div
        class="c4-win c4-win-hero"
        role="img"
        aria-label="The app in use with made-up demo data: a to-do ticked on Today, an application dragged from Applied to Screen on the board, then the Sankey diagram of the whole search on Insights."
      >
        <div class="c4-win-bar" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
          <span class="c4-win-url">127.0.0.1:8770</span>
        </div>
        <div class="c4-app" data-c4-app aria-hidden="true">
          <Image src={chrome} alt="" width={1440} class="c4-app-img" loading="eager" />
          <i class="c4-app-active" data-active></i>
          <div class="c4-app-pages">
            <div class="c4-page is-on" data-page="today">
              <div class="c4-page-scroll" data-scroll>
                <Image src={todayFull} alt="" width={1440} class="c4-app-img" loading="eager" />
                <i class="c4-todo-dim" data-todo-dim></i>
                <i class="c4-todo-strike" data-todo-strike></i>
                <i class="c4-todo-box" data-todo-box>
                  <svg viewBox="0 0 16 16">
                    <path d="M3.5 8.5l3 3 6-7"></path>
                  </svg>
                </i>
              </div>
            </div>
            <div class="c4-page" data-page="board">
              <Image src={board} alt="" width={1440} class="c4-app-img" />
              <i class="c4-patch c4-patch-bottom"></i>
              <div class="c4-below" data-below>
                <Image src={board} alt="" width={1440} class="c4-app-img" />
              </div>
              <i class="c4-patch c4-patch-slot" data-slot></i>
              <i class="c4-grow" data-grow></i>
              <span class="c4-count c4-count-a" data-count>
                3
              </span>
              <span class="c4-count c4-count-s" data-count>
                1
              </span>
              <div class="c4-card" data-card>
                <b>Adventure Works</b>
                <span>Backend Engineer (Go)</span>
                <small>3 days ago</small>
              </div>
            </div>
            <div class="c4-page" data-page="insights">
              <Image src={insights} alt="" width={1440} class="c4-app-img" />
              <div class="c4-tip" data-tip>
                <b>Applied → Screen</b>
                <span>4 roles</span>
              </div>
            </div>
          </div>
          <div class="c4-cursor" data-cursor>
            <i class="c4-ripple"></i>
            <svg viewBox="0 0 20 20">
              <path d="M3 2l13 8.2-5.6 1.3 3.3 6-2.6 1.3-3.2-6.1L3 16.6z"></path>
            </svg>
          </div>
        </div>
      </div>
      <div class="c4-chip c4-chip-a" aria-hidden="true">
        <i class="c4-chip-dot"></i>
        <span>
          <b>Round 3 · System design</b>
          <small>Contoso · Sat 14 Nov</small>
        </span>
      </div>
      <div class="c4-chip c4-chip-b" aria-hidden="true">
        <i class="c4-chip-dot c4-chip-dot-v"></i>
        <span>
          <b>Saved on this computer</b>
          <small>~/job-search-data</small>
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  import "./hero";
</script>
