---
// After the journey: privacy, the small things, quick start, FAQ and the inset footer panel.
import { FAQ, GUIDE, REPO, markZh } from "../../data";

const small = [
  ["Notes you keep", "Write notes in the app. They're saved as ordinary text files you can open anywhere."],
  ["Search everything", "Press / to search applications, people, debriefs, notes, files and links."],
  ["CV versions", "Every tailored CV and cover letter, and which one each company got."],
  ["Your own stages", "Rename, add or remove the steps an application goes through, in a settings file."],
  ["Today", "Your move, what's coming up and who you're waiting on, in one list each morning."],
  [
    "English and 简体中文",
    "The whole app, buttons to dates, in English or Simplified Chinese. Switch in the header.",
  ],
];

type Line = { cmd?: string; out?: string; note?: string };
const tabs: { id: string; label: string; lines: Line[] }[] = [
  {
    id: "install",
    label: "Install",
    lines: [
      { cmd: "git clone https://github.com/waddington/job-application-tracker.git" },
      { cmd: "cd job-application-tracker" },
      { cmd: "uv sync" },
      { cmd: "pnpm --dir frontend install && pnpm --dir frontend build" },
      { out: "✓ built the web UI into frontend/dist" },
    ],
  },
  {
    id: "demo",
    label: "Try the demo",
    lines: [
      { note: "# made-up companies and people; needs a new or empty folder" },
      { cmd: "uv run python scripts/seed_demo.py /tmp/jat-demo" },
      { cmd: "uv run jat --data-dir /tmp/jat-demo serve" },
      { out: "→ http://127.0.0.1:8770" },
    ],
  },
  {
    id: "real",
    label: "Use it for real",
    lines: [
      { cmd: "mkdir -p ~/job-search-data && git -C ~/job-search-data init" },
      { cmd: "git -C ~/job-search-data remote add origin <your-private-repo-url>" },
      { cmd: "cp .env.example .env" },
      { note: "# then set JAT_DATA_DIR=~/job-search-data in .env" },
      { cmd: "uv run jat init" },
      { cmd: "uv run jat serve" },
      { out: "→ http://127.0.0.1:8770 (keeps running)" },
      { cmd: "uv run jat push" },
      { out: "✓ snapshots sent to your private repo" },
    ],
  },
];
const needs = ["Python 3.12 to 3.14", "uv", "Node.js 22.12+", "pnpm", "git (optional)"];
const faqs = FAQ.filter((f) =>
  [
    "Is it free?",
    "Do I need to be technical?",
    "Does it use AI?",
    "Where is my data stored?",
    "Does it run on Windows?",
    "Is it available in my language?",
    "How do I back it up?",
    "Is it ready?",
  ].includes(f.q),
);
// FAQ answers may hold `code` and [links](…); show them as such (the same text the current site shows).
const rich = (a: string) =>
  markZh(a.replaceAll("&", "&amp;").replaceAll("<", "&lt;"))
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\[([^\]]+)\]\((https:\/\/[^)\s]+)\)/g, '<a href="$2">$1</a>');
const year = new Date().getFullYear();
---

<section class="c4-centre" data-tint="black">
  <p class="c4-centre-line">No AI. No cloud. No account. No tracking.<br />Nothing leaves your computer.</p>
</section>

<section class="c4-privacy" id="privacy" data-tint="black" aria-labelledby="h-priv">
  <div class="c4-panel">
    <div class="c4-panel-copy">
      <p class="c4-eyebrow">Private by design</p>
      <h2 class="c4-h2" id="h-priv">Your job hunt is nobody else's business.</h2>
      <p class="c4-body-text">
        Salaries, recruiters' names, interview notes and the CV you tailored at 1am live in one folder you own, in
        formats you can read without the app. It never sends email, contacts anyone or calls out to the web.
      </p>
      <a class="c4-btn c4-glass" href={`${GUIDE}your-data.md`}>How your data is stored</a>
    </div>
    <ol class="c4-stack" aria-label="Where everything runs">
      <li><small>Your browser</small><b>127.0.0.1:8770</b><span>React · Mantine · d3-sankey</span></li>
      <li><small>The app</small><b>FastAPI + SQLite</b><span>Python, run with uv</span></li>
      <li><small>Your folder</small><b>~/job-search-data</b><span>export/*.jsonl · notes/*.md · files/</span></li>
      <li class="is-opt"><small>Optional</small><b>Your private git repo</b><span>full history, off-machine</span></li>
    </ol>
  </div>
</section>

<section class="c4-small" data-tint="black" aria-labelledby="h-small">
  <p class="c4-eyebrow">And the small things</p>
  <h2 class="c4-h2" id="h-small">Built for the way a search actually goes.</h2>
  <ul class="c4-small-grid">
    {
      small.map(([t, b]) => (
        <li>
          <b set:html={markZh(t)} />
          <span>{b}</span>
        </li>
      ))
    }
  </ul>
</section>

<section class="c4-qs" id="quickstart" data-tint="black" aria-labelledby="h-qs">
  <p class="c4-eyebrow">Quick start</p>
  <h2 class="c4-h2" id="h-qs">Set up in about ten minutes.</h2>
  <p class="c4-body-text c4-qs-lede">
    No installer yet: with uv and Node.js on your computer, you paste a few commands into the Terminal once. After
    that it's a web page in your browser. Mac or Linux; Windows is next on the roadmap.
  </p>
  <ul class="c4-needs" aria-label="What you need">{needs.map((x) => <li>{x}</li>)}</ul>
  <div class="c4-term-wrap">
    <div class="c4-tabs c4-glass" role="tablist" aria-label="Quick start steps">
      {
        tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`c4-tab-${t.id}`}
            aria-controls={`c4-panel-${t.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="c4-tab-n">{i + 1}</span> {t.label}
          </button>
        ))
      }
    </div>
    <div class="c4-term">
      <div class="c4-term-bar" aria-hidden="true"><i></i><i></i><i></i><span>Terminal</span></div>
      {
        tabs.map((t, i) => (
          <pre
            class="c4-term-panel"
            role="tabpanel"
            id={`c4-panel-${t.id}`}
            aria-labelledby={`c4-tab-${t.id}`}
            hidden={i !== 0}
            tabindex="0"
          >
            {t.lines.map((l) =>
              l.cmd ? (
                <span class="c4-l">
                  <span class="c4-p" aria-hidden="true">$</span>
                  {l.cmd}
                </span>
              ) : l.note ? (
                <span class="c4-l c4-l-note">{l.note}</span>
              ) : (
                <span class="c4-l c4-l-out">{l.out}</span>
              ),
            )}
          </pre>
        ))
      }
    </div>
  </div>
  <div class="c4-ctas c4-ctas-c">
    <a class="c4-btn c4-btn-solid" href={`${GUIDE}install.md`}>Read the install guide</a>
    <a class="c4-btn c4-glass" href={REPO}>View on GitHub</a>
  </div>
</section>

<section class="c4-faq" id="faq" data-tint="black" aria-labelledby="h-faq">
  <div class="c4-faq-head">
    <p class="c4-eyebrow">Questions</p>
    <h2 class="c4-h2" id="h-faq">Asked before you install.</h2>
  </div>
  <div class="c4-faq-list">
    {
      faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p set:html={rich(f.a)} />
        </details>
      ))
    }
  </div>
</section>

<footer class="c4-foot" data-tint="black">
  <div class="c4-foot-panel">
    <div class="c4-foot-top">
      <p class="c4-foot-big">Your next offer is in there somewhere.</p>
      <a class="c4-btn c4-btn-solid" href={`${GUIDE}install.md`}>Get started</a>
    </div>
    <div class="c4-foot-cols">
      <div>
        <b>Job Application Tracker</b>
        <span>Free, private and open source.</span>
      </div>
      <nav aria-label="Docs">
        <h2>Docs</h2>
        <a href={`${GUIDE}install.md`}>Install</a>
        <a href={`${GUIDE}your-data.md`}>Your data</a>
        <a href={`${GUIDE}using-the-app.md`}>Using the app</a>
        <a href={`${GUIDE}commands.md`}>Commands</a>
      </nav>
      <nav aria-label="Project">
        <h2>Project</h2>
        <a href={REPO}>GitHub</a>
        <a href={`${REPO}/issues`}>Issues</a>
        <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Contributing</a>
        <a href={`${REPO}/blob/main/CHANGELOG.md`}>Changelog</a>
      </nav>
    </div>
    <p class="c4-foot-fine">
      © {year} Kai Waddington · <a href={`${REPO}/blob/main/LICENSE`}>Apache-2.0</a>. Screenshots show made-up demo
      data. This site adds no cookies, analytics or trackers.
    </p>
  </div>
</footer>
