---
// Concept 6, "Espresso × Liquid" (docs/rfc/website-redesign.md, round 2): Espresso's warm palette and long scroll,
// with Liquid's immersive tour inside the app. Its own shell: fonts, a slow copper-and-cream mesh (no dots), the
// page tint per section, and liquid-glass chrome that catches the pointer. Everything is prefixed `c6-`.
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import Switcher from "../Switcher.astro";
import { REPO } from "../../data";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="c6-html" data-tint="ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Concept 6 · Espresso × Liquid · Job Application Tracker</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body class="c6-body">
    <a class="c6-skip" href="#c6-main">
      Skip to content
    </a>
    <div class="c6-mesh" aria-hidden="true">
      <i data-t="ink"></i>
      <i data-t="paper"></i>
      <i data-t="taupe"></i>
      <i data-t="cream"></i>
      <i data-t="espresso"></i>
      <b class="c6-blob c6-blob--a"></b>
      <b class="c6-blob c6-blob--b"></b>
      <b class="c6-blob c6-blob--c"></b>
      <b class="c6-light"></b>
    </div>

    <header class="c6-chrome">
      <a class="c6-glass c6-logo" href="#c6-main" aria-label="Job Application Tracker, back to the top">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <circle cx="12" cy="12" r="4.5"></circle>
          <circle cx="12" cy="12" r="1.2" fill="currentColor"></circle>
        </svg>
      </a>
      <nav class="c6-glass c6-nav" aria-label="Sections">
        <a href="#c6-private">Private</a>
        <a href="#c6-tour">The tour</a>
        <a href="#c6-languages">Languages</a>
        <a href="#c6-get">Quick start</a>
      </nav>
      <div class="c6-right">
        <a class="c6-pill c6-glass c6-gh" href={REPO}>
          <span>GitHub</span>
        </a>
        <a class="c6-pill c6-pill--copper" href="#c6-get">
          <span>Get it</span>
        </a>
      </div>
    </header>

    <slot />
    <Switcher current="6" />

    <script>
      // The page tint: whichever section holds the middle of the screen.
      const root = document.documentElement;
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries)
            if (e.isIntersecting) root.dataset.tint = (e.target as HTMLElement).dataset.c6Tint;
        },
        { rootMargin: "-50% 0px -50% 0px" },
      );
      document.querySelectorAll<HTMLElement>("[data-c6-tint]").forEach((s) => io.observe(s));

      // Glass catches the light: a soft highlight inside each pane slides toward the pointer (transform only).
      if (matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches) {
        const panes = [...document.querySelectorAll<HTMLElement>(".c6-glass")];
        const sheens = panes.map((p) => {
          const s = document.createElement("span");
          s.className = "c6-sheen";
          s.setAttribute("aria-hidden", "true");
          p.prepend(s);
          return s;
        });
        let mx = 0;
        let my = 0;
        let queued = false;
        const paint = () => {
          queued = false;
          panes.forEach((p, i) => {
            const r = p.getBoundingClientRect();
            if (r.bottom < 0 || r.top > innerHeight) return;
            sheens[i].style.transform =
              `translate(${(mx - r.left).toFixed(0)}px, ${(my - r.top).toFixed(0)}px)`;
            sheens[i].style.opacity = String(
              Math.max(0, 1 - Math.hypot(mx - (r.left + r.width / 2), my - (r.top + r.height / 2)) / 600),
            );
          });
        };
        addEventListener(
          "pointermove",
          (e) => {
            mx = e.clientX;
            my = e.clientY;
            if (!queued) {
              queued = true;
              requestAnimationFrame(paint);
            }
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>

<style is:global>
  .c6-html {
    --c6-ink: #0d0b09;
    --c6-paper: #f6f3ee;
    --c6-taupe: #c9bcad;
    --c6-cream: #eee3d1;
    --c6-espresso: #2a1c14;
    --c6-espresso-deep: #1a110b;
    --c6-copper: #c47a48;
    --c6-copper-hi: #e0a072;
    --c6-ease: cubic-bezier(0.22, 0.61, 0.24, 1);
    --c6-fg: #f3ece2;
    --c6-fg-soft: rgb(243 236 226 / 0.64);
    --c6-glass-a: 0.1;
    --c6-glass-line: rgb(255 255 255 / 0.2);
    --c6-mono: "JetBrains Mono Variable", ui-monospace, monospace;
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
    background: var(--c6-ink);
    overflow-x: clip;
  }
  .c6-html[data-tint="paper"],
  .c6-html[data-tint="taupe"],
  .c6-html[data-tint="cream"] {
    --c6-fg: #241912;
    --c6-fg-soft: rgb(36 25 18 / 0.62);
    --c6-glass-a: 0.42;
    --c6-glass-line: rgb(255 255 255 / 0.65);
  }
  @media (prefers-reduced-motion: reduce) {
    .c6-html {
      scroll-behavior: auto;
    }
  }
  .c6-body {
    margin: 0;
    color: var(--c6-fg);
    font:
      400 17px/1.55 "Inter Variable",
      system-ui,
      sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
    transition: color 0.6s var(--c6-ease);
  }
  .c6-body *,
  .c6-body *::before,
  .c6-body *::after {
    box-sizing: border-box;
  }
  .c6-body a {
    color: inherit;
  }
  .c6-body :focus-visible {
    outline: 2px solid var(--c6-copper);
    outline-offset: 3px;
  }
  .c6-skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--c6-copper);
    color: #1b110b !important;
  }
  .c6-skip:focus {
    top: 12px;
  }
  .c6-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The mesh: a tint per section (opacity only) and three slow copper/cream lights over it. */
  .c6-mesh {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .c6-mesh i {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s var(--c6-ease);
  }
  .c6-mesh [data-t="ink"] {
    background: var(--c6-ink);
    opacity: 1;
  }
  .c6-mesh [data-t="paper"] {
    background: var(--c6-paper);
  }
  .c6-mesh [data-t="taupe"] {
    background: var(--c6-taupe);
  }
  .c6-mesh [data-t="cream"] {
    background: var(--c6-cream);
  }
  .c6-mesh [data-t="espresso"] {
    background: var(--c6-espresso-deep);
  }
  .c6-html[data-tint="paper"] .c6-mesh [data-t="paper"],
  .c6-html[data-tint="taupe"] .c6-mesh [data-t="taupe"],
  .c6-html[data-tint="cream"] .c6-mesh [data-t="cream"],
  .c6-html[data-tint="espresso"] .c6-mesh [data-t="espresso"] {
    opacity: 1;
  }
  .c6-blob {
    position: absolute;
    width: 72vmax;
    height: 72vmax;
    border-radius: 50%;
    opacity: 0.55;
    will-change: transform;
    animation: c6-float 38s var(--c6-ease) infinite alternate;
  }
  .c6-blob--a {
    left: -24vmax;
    top: -30vmax;
    background: radial-gradient(closest-side, rgb(196 122 72 / 0.75), rgb(196 122 72 / 0.2) 50%, transparent);
  }
  .c6-blob--b {
    right: -30vmax;
    top: 10vmax;
    background: radial-gradient(
      closest-side,
      rgb(238 210 170 / 0.7),
      rgb(238 210 170 / 0.18) 50%,
      transparent
    );
    animation-duration: 46s;
    animation-delay: -14s;
  }
  .c6-blob--c {
    left: 10vmax;
    bottom: -44vmax;
    background: radial-gradient(closest-side, rgb(150 80 50 / 0.6), rgb(150 80 50 / 0.15) 50%, transparent);
    animation-duration: 41s;
    animation-delay: -24s;
  }
  .c6-html[data-tint="paper"] .c6-blob,
  .c6-html[data-tint="cream"] .c6-blob {
    opacity: 0.32;
  }
  .c6-light {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 150vmax;
    height: 150vmax;
    margin: -75vmax 0 0 -75vmax;
    background: conic-gradient(
      from 20deg,
      transparent,
      rgb(255 220 180 / 0.14) 35deg,
      transparent 80deg,
      transparent 190deg,
      rgb(255 200 160 / 0.1) 230deg,
      transparent 280deg
    );
    -webkit-mask: radial-gradient(closest-side, #000 20%, transparent 75%);
    mask: radial-gradient(closest-side, #000 20%, transparent 75%);
    animation: c6-spin 110s linear infinite;
  }
  @keyframes c6-float {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(8vmax, 6vmax, 0) scale(1.12);
    }
    100% {
      transform: translate3d(-6vmax, 9vmax, 0) scale(0.94);
    }
  }
  @keyframes c6-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .c6-blob,
    .c6-light {
      animation: none;
    }
    .c6-mesh i,
    .c6-body {
      transition: none;
    }
  }

  /* Shared pieces. */
  .c6-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    font: 500 11.5px/1.2 var(--c6-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .c6-eyebrow::before {
    content: "";
    flex: none;
    width: 7px;
    height: 7px;
    background: var(--c6-copper);
  }
  .c6-display {
    margin: 0;
    font-weight: 300;
    font-size: clamp(38px, 5vw, 68px);
    line-height: 1.03;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .c6-h2 {
    margin: 0;
    font-weight: 300;
    font-size: clamp(32px, 3.6vw, 52px);
    line-height: 1.07;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .c6-soft {
    color: var(--c6-fg-soft);
  }
  .c6-glass {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.24), rgb(255 255 255 / 0) 55%),
      rgb(255 255 255 / var(--c6-glass-a));
    border: 1px solid var(--c6-glass-line);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      inset 1.5px 0 0 rgb(255 170 120 / 0.18),
      inset -1.5px 0 0 rgb(255 240 210 / 0.2),
      0 14px 36px -14px rgb(0 0 0 / 0.4);
    backdrop-filter: blur(22px) saturate(1.5);
    -webkit-backdrop-filter: blur(22px) saturate(1.5);
    transition:
      background 0.6s var(--c6-ease),
      border-color 0.6s var(--c6-ease);
  }
  .c6-glass > .c6-sheen {
    position: absolute;
    left: -110px;
    top: -110px;
    z-index: -1;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(255 230 200 / 0.55),
      rgb(255 230 200 / 0.12) 55%,
      transparent
    );
    opacity: 0;
    pointer-events: none;
  }
  .c6-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 22px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.4s var(--c6-ease);
  }
  .c6-pill:hover {
    transform: translateY(-2px);
  }
  .c6-body .c6-pill--copper {
    color: #1b110b;
    background: linear-gradient(180deg, var(--c6-copper-hi), var(--c6-copper));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.45),
      0 12px 30px -10px rgb(196 122 72 / 0.7);
  }

  /* Chrome. */
  .c6-chrome {
    position: fixed;
    z-index: 50;
    top: 16px;
    left: 16px;
    right: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }
  .c6-chrome > * {
    pointer-events: auto;
  }
  .c6-logo {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
  }
  .c6-logo svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }
  .c6-nav {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 2px;
    padding: 5px;
    border-radius: 999px;
  }
  .c6-nav a {
    padding: 9px 16px;
    border-radius: 999px;
    font-size: 14px;
    text-decoration: none;
    transition: background 0.3s;
  }
  .c6-nav a:hover {
    background: rgb(255 255 255 / 0.14);
  }
  .c6-right {
    display: flex;
    gap: 8px;
  }
  .c6-right .c6-pill {
    padding: 11px 18px;
    font-size: 14px;
  }
  @media (max-width: 760px) {
    .c6-nav,
    .c6-gh {
      display: none;
    }
    .c6-chrome {
      top: 10px;
      left: 10px;
      right: 10px;
    }
  }
</style>
