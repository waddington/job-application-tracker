---
// The hero: a tilted browser built in CSS 3D, showing the app being used (screenshots of made-up demo
// data, with a few pieces rebuilt in HTML so they can really move), and UI chips orbiting it.
import { Image } from "astro:assets";
import DotShape from "./DotShape.astro";
import chrome from "./shots/chrome.png";
import todayFull from "./shots/today-full.png";
import board from "./shots/board.png";
import role from "./shots/role.png";
import insights from "./shots/insights.png";

const shotProps = { widths: [800, 1440], sizes: "(max-width: 600px) 400px, 800px" };
const chips = [
  { a: "20deg", y: "-190px", kind: "stage" },
  { a: "110deg", y: "150px", kind: "todo" },
  { a: "200deg", y: "-120px", kind: "round" },
  { a: "290deg", y: "190px", kind: "star" },
];
---

<section class="c5-block c5-hero" data-tint="lilac" aria-labelledby="c5-hero-h">
  <DotShape shape="bubble" cols={30} rows={22} class="c5-hero-dots" />
  <div class="c5-wrap c5-hero-grid">
    <div class="c5-hero-copy">
      <p class="c5-eyebrow">Free, open source, in daily use</p>
      <h1 class="c5-display" id="c5-hero-h">Your job search, on your own computer.</h1>
      <p class="c5-lede">
        Track every application, recruiter, interview round, follow-up and offer, and see exactly who to chase
        today. No account, no subscription, nobody watching.
      </p>
      <div class="c5-ctas">
        <a class="c5-btn c5-btn-ink" href="#c5-start">Get started, it's free</a>
        <a class="c5-btn c5-glass" href="#c5-play">Try the pieces</a>
      </div>
      <ul class="c5-promises" aria-label="Promises">
        <li>No sign-up</li>
        <li>No AI</li>
        <li>No cloud</li>
        <li>No tracking</li>
        <li>Apache-2.0</li>
      </ul>
    </div>

    <div class="c5-stage" data-c5-stage>
      <div class="c5-rig" data-c5-rig>
        <div class="c5-drift">
          <div class="c5-plate2" aria-hidden="true"></div>
          <div class="c5-plate" aria-hidden="true"></div>
          <div class="c5-win">
            <div class="c5-bar" aria-hidden="true"><i></i><i></i><i></i><span>127.0.0.1:8770</span></div>
            <div
              class="c5-screen"
              data-c5-screen
              role="img"
              aria-label="The app in use with made-up demo data: a to-do ticked on Today, a card dragged across the board, a role marked applied, and the Insights Sankey."
            >
              <div class="c5-app" data-c5-app aria-hidden="true">
                <Image src={chrome} alt="" class="c5-chrome" {...shotProps} loading="eager" />
                <div class="c5-hl" data-hl></div>
                <div class="c5-view">
                  <div class="c5-pg on" data-pg="today">
                    <div class="c5-scroll" data-today-scroll>
                      <Image src={todayFull} alt="" class="c5-shot" {...shotProps} loading="eager" />
                      <div class="c5-ov c5-ov-box"></div>
                      <div class="c5-ov c5-ov-tick" data-tick>
                        <svg viewBox="0 0 20 20" fill="none" stroke="#fff" stroke-width="2.4"
                          ><path d="M5 10.5l3.2 3.2L15 7" stroke-linecap="round" stroke-linejoin="round"></path></svg
                        >
                      </div>
                      <div class="c5-ov c5-ov-strike" data-strike></div>
                      <div class="c5-ov c5-ov-fade" data-rowfade></div>
                    </div>
                  </div>
                  <div class="c5-pg" data-pg="board">
                    <Image src={board} alt="" class="c5-shot" {...shotProps} />
                    <div class="c5-ov c5-ov-mask" data-mask></div>
                    <div class="c5-ov c5-ov-col" data-colgrow></div>
                    <div class="c5-ov c5-ov-count" style="left:500px;top:188px" data-count-a>3</div>
                    <div class="c5-ov c5-ov-count" style="left:763px;top:188px" data-count-b>1</div>
                    <div class="c5-ov c5-ov-card" data-card>
                      <b>Adventure Works</b><small>Backend Engineer (Go)</small><small>3 days ago</small>
                    </div>
                  </div>
                  <div class="c5-pg" data-pg="role">
                    <Image src={role} alt="" class="c5-shot" {...shotProps} />
                    <div class="c5-ov c5-ov-badge a" data-badge-a>TO DECIDE</div>
                    <div class="c5-ov c5-ov-badge b" data-badge-b>APPLIED</div>
                  </div>
                  <div class="c5-pg" data-pg="insights">
                    <Image src={insights} alt="" class="c5-shot" {...shotProps} />
                    <div class="c5-ov c5-ov-wipe" data-wipe></div>
                  </div>
                </div>
                <div class="c5-ripple" data-ripple></div>
                <div class="c5-cursor" data-cursor>
                  <svg viewBox="0 0 24 24"
                    ><path
                      d="M4 2.5l15.5 9.2-6.9 1.5 3.9 7.2-2.8 1.5-3.9-7.2L4.6 19z"
                      fill="#111"
                      stroke="#fff"
                      stroke-width="1.4"
                      stroke-linejoin="round"></path></svg
                  >
                </div>
              </div>
            </div>
          </div>

          <div class="c5-orbit-tilt" aria-hidden="true">
            <div class="c5-orbit">
              {
                chips.map((c) => (
                  <div class="c5-chip" style={`--a:${c.a};--y:${c.y}`}>
                    <div class="c5-chip-face">
                      {c.kind === "stage" && (
                        <div class="c5-chip-in">
                          <span class="c5-ico" style="background:var(--c5-mint)">
                            ↗
                          </span>
                          <div>
                            <small>Contoso</small>
                            <span class="c5-pillbadge" style="background:#e5dbff;color:#5f3dc4">
                              Interviewing
                            </span>
                          </div>
                        </div>
                      )}
                      {c.kind === "todo" && (
                        <div class="c5-chip-in">
                          <span class="c5-ico" style="background:var(--c5-ink);color:#fff">
                            ✓
                          </span>
                          <div>
                            <b>Ask who's on the platform team</b>
                            <small>To-do · by 14 Nov</small>
                          </div>
                        </div>
                      )}
                      {c.kind === "round" && (
                        <div class="c5-chip-in">
                          <span class="c5-ico" style="background:var(--c5-butter)">
                            3
                          </span>
                          <div>
                            <b>Round 3 · System design</b>
                            <small>Fri 14 Nov, 14:30</small>
                          </div>
                        </div>
                      )}
                      {c.kind === "star" && (
                        <div class="c5-chip-in">
                          <span class="c5-ico" style="background:var(--c5-pink)">
                            ★
                          </span>
                          <div>
                            <b>Jordan Lee</b>
                            <small>Northwind Talent · replies in a day</small>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const stage = document.querySelector<HTMLElement>("[data-c5-stage]");
  const rig = document.querySelector<HTMLElement>("[data-c5-rig]");
  const screen = document.querySelector<HTMLElement>("[data-c5-screen]");
  const app = document.querySelector<HTMLElement>("[data-c5-app]");

  // Scale the 1440 x 900 app to whatever width the window has.
  if (screen && app) {
    const fit = () => app.style.setProperty("--k", String(screen.clientWidth / 1440));
    fit();
    new ResizeObserver(fit).observe(screen);
  }

  // ---- scroll-linked turn, with a little pop-and-wobble from scroll speed (a damped spring) ----
  if (stage && rig && !reduce) {
    let lastY = scrollY;
    let wob = 0; // current wobble
    let vel = 0; // its velocity
    let pop = 0.86; // scale, springs up to 1 on load
    let popV = 0;
    let running = false;
    const tick = () => {
      const rect = stage.getBoundingClientRect();
      const p = Math.min(1.4, Math.max(0, -rect.top / Math.max(1, rect.height))); // 0 at rest, grows as it leaves
      const dy = scrollY - lastY;
      lastY = scrollY;
      // a scroll flick kicks the spring; it settles back with a small overshoot
      vel += Math.max(-3, Math.min(3, dy * 0.06));
      vel += -wob * 0.09;
      vel *= 0.82;
      wob += vel;
      popV += (1 - pop) * 0.12;
      popV *= 0.78;
      pop += popV;
      rig.style.setProperty("--ry", `${-24 + p * 34 + wob * 0.6}deg`);
      rig.style.setProperty("--rx", `${10 + p * 10 - wob * 0.4}deg`);
      rig.style.setProperty("--rz", `${-4 + p * 6 + wob}deg`);
      rig.style.setProperty("--s", String(pop * (1 - p * 0.08) + Math.abs(wob) * 0.004));
      rig.style.setProperty("--ty", `${p * 80}px`);
      const settled = Math.abs(vel) < 0.001 && Math.abs(wob) < 0.001 && Math.abs(1 - pop) < 0.0005;
      if (settled) {
        running = false;
        return;
      }
      requestAnimationFrame(tick);
    };
    const kick = () => {
      if (!running) {
        running = true;
        requestAnimationFrame(tick);
      }
    };
    addEventListener("scroll", kick, { passive: true });
    kick();
  }

  // ---- the app being used: a looping, pausable sequence of Web Animations ----
  if (app && screen) {
    const $ = (sel: string) => app.querySelector<HTMLElement>(sel)!;
    const cursor = $("[data-cursor]");
    const ripple = $("[data-ripple]");
    const hl = $("[data-hl]");
    const pages = Object.fromEntries(
      [...app.querySelectorAll<HTMLElement>("[data-pg]")].map((el) => [el.dataset.pg!, el]),
    );
    const live = new Set<Animation>();
    let paused = false;
    let cx = 980;
    let cy = 560;
    const ease = "cubic-bezier(.45,0,.2,1)";

    const run = async (el: Element, kf: Keyframe[], opts: KeyframeAnimationOptions) => {
      const a = el.animate(kf, { fill: "forwards", easing: ease, ...opts });
      live.add(a);
      if (paused) a.pause();
      try {
        await a.finished;
        a.commitStyles();
      } finally {
        live.delete(a);
        a.cancel();
      }
    };
    const sleep = (ms: number) => run(ripple, [{}, {}], { duration: ms, fill: "none" });
    const move = (x: number, y: number, ms = 800) => {
      const from = `translate(${cx}px, ${cy}px)`;
      cx = x;
      cy = y;
      return run(cursor, [{ transform: from }, { transform: `translate(${x}px, ${y}px)` }], { duration: ms });
    };
    const click = async () => {
      ripple.style.transform = `translate(${cx + 4}px, ${cy + 4}px)`;
      run(
        ripple,
        [
          { opacity: 1, transform: `translate(${cx + 4}px, ${cy + 4}px) scale(.2)` },
          { opacity: 0, transform: `translate(${cx + 4}px, ${cy + 4}px) scale(1.4)` },
        ],
        { duration: 550, easing: "ease-out" },
      );
      await run(
        cursor,
        [
          { transform: `translate(${cx}px, ${cy}px) scale(1)` },
          { transform: `translate(${cx}px, ${cy}px) scale(.82)` },
          { transform: `translate(${cx}px, ${cy}px) scale(1)` },
        ],
        { duration: 260 },
      );
    };
    const navTo = async (name: string, hlTop: number, from: string) => {
      const prev = getComputedStyle(hl).transform;
      await run(hl, [{ transform: prev === "none" ? "translateY(0)" : prev }, { transform: `translateY(${hlTop - 66}px)` }], {
        duration: 320,
      });
      const next = pages[name];
      const old = pages[from];
      next.style.zIndex = "2";
      old.style.zIndex = "1";
      await Promise.all([
        run(
          next,
          [
            { opacity: 0, transform: "translateX(70px)" },
            { opacity: 1, transform: "translateX(0)" },
          ],
          { duration: 600 },
        ),
        run(old, [{ opacity: 1 }, { opacity: 0 }], { duration: 600 }),
      ]);
    };
    const reset = () => {
      for (const el of app.querySelectorAll<HTMLElement>("[style]")) {
        if (el === app || el.matches(".c5-ov-count")) continue;
        el.style.removeProperty("transform");
        el.style.removeProperty("opacity");
        el.style.removeProperty("z-index");
      }
      for (const el of app.querySelectorAll<HTMLElement>(".c5-ov-count")) el.style.opacity = "0";
      for (const [name, el] of Object.entries(pages)) el.style.opacity = name === "today" ? "1" : "0";
    };

    const loop = async () => {
      for (;;) {
        reset();
        cursor.style.transform = `translate(${cx}px, ${cy}px)`;
        await sleep(700);
        // Today: scroll down to the to-dos and tick one
        await Promise.all([
          run($("[data-today-scroll]"), [{ transform: "translateY(0)" }, { transform: "translateY(-480px)" }], {
            duration: 1700,
          }),
          move(700, 520, 1200),
        ]);
        await move(286, 398, 800);
        await click();
        await Promise.all([
          run($("[data-tick]"), [{ opacity: 0, transform: "scale(.4)" }, { opacity: 1, transform: "scale(1)" }], {
            duration: 260,
            easing: "cubic-bezier(.3,1.6,.5,1)",
          }),
          run($("[data-strike]"), [{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }], {
            duration: 450,
            delay: 120,
          }),
        ]);
        await run($("[data-rowfade]"), [{ opacity: 0 }, { opacity: 0.55 }], { duration: 500, delay: 300 });
        // to the board
        await move(110, 201, 900);
        await click();
        await navTo("board", 181, "today");
        // drag Adventure Works from Applied to Screen
        const card = $("[data-card]");
        await move(640, 320, 900);
        await run(
          card,
          [
            { transform: "translate(0,0) rotate(0) scale(1)", boxShadow: "0 0 0 rgba(0,0,0,0)" },
            { transform: "translate(0,-6px) rotate(2.5deg) scale(1.04)", boxShadow: "0 24px 40px -12px rgba(0,0,0,.3)" },
          ],
          { duration: 220 },
        );
        $("[data-mask]").style.opacity = "1";
        await Promise.all([
          move(902, 320, 1000),
          run(
            card,
            [
              { transform: "translate(0,-6px) rotate(2.5deg) scale(1.04)" },
              { transform: "translate(262px,-6px) rotate(2.5deg) scale(1.04)" },
            ],
            { duration: 1000 },
          ),
          run($("[data-colgrow]"), [{ transform: "scaleY(0)" }, { transform: "scaleY(1)" }], {
            duration: 400,
            delay: 600,
          }),
        ]);
        await run(
          card,
          [
            { transform: "translate(262px,-6px) rotate(2.5deg) scale(1.04)", boxShadow: "0 24px 40px -12px rgba(0,0,0,.3)" },
            { transform: "translate(262px,0) rotate(0) scale(1)", boxShadow: "0 0 0 rgba(0,0,0,0)" },
          ],
          { duration: 300, easing: "cubic-bezier(.3,1.5,.5,1)" },
        );
        $("[data-count-a]").style.opacity = "1";
        $("[data-count-b]").style.opacity = "1";
        await sleep(700);
        // a role: mark it applied
        await move(90, 161, 900);
        await click();
        await navTo("role", 141, "board");
        await move(1090, 122, 1000);
        await click();
        await Promise.all([
          run($("[data-badge-a]"), [{ opacity: 1, transform: "scale(1)" }, { opacity: 0, transform: "scale(.6)" }], {
            duration: 220,
          }),
          run(
            $("[data-badge-b]"),
            [
              { opacity: 0, transform: "scale(.6)" },
              { opacity: 1, transform: "scale(1)" },
            ],
            { duration: 380, delay: 160, easing: "cubic-bezier(.3,1.6,.5,1)" },
          ),
        ]);
        await sleep(800);
        // insights: the Sankey draws itself
        await move(90, 588, 1000);
        await click();
        await navTo("insights", 568, "role");
        await Promise.all([
          run($("[data-wipe]"), [{ transform: "scaleX(1)" }, { transform: "scaleX(0)" }], {
            duration: 1600,
            easing: "cubic-bezier(.6,0,.2,1)",
          }),
          move(1010, 470, 1700),
        ]);
        await sleep(1800);
        // back to Today
        await move(80, 86, 900);
        await click();
        await navTo("today", 66, "insights");
        await sleep(300);
      }
    };

    const setPaused = (p: boolean) => {
      paused = p;
      for (const a of live) {
        if (p) a.pause();
        else a.play();
      }
    };

    if (reduce) {
      // a still frame: Today, with the to-do ticked
      $("[data-tick]").style.cssText = "opacity:1;transform:none";
      $("[data-strike]").style.transform = "scaleX(1)";
      cursor.style.transform = "translate(300px, 880px)";
    } else {
      let started = false;
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !started) {
          started = true;
          loop().catch(() => {});
        }
        setPaused(!e.isIntersecting || document.hidden);
      }).observe(screen);
      document.addEventListener("visibilitychange", () => setPaused(document.hidden));
    }
  }
</script>
