---
// The whole page is one object: a browser window built from glass panes. It starts small and tilted in the hero,
// grows to fill the screen, and the tour happens inside it (scroll drives the app from page to page while glass
// captions float over it). Then it comes apart into its layers (the privacy story), and shrinks back out.
// With reduced motion the stage is hidden and each chapter shows its own still picture instead.
import { Image } from "astro:assets";
import { MARQUEE } from "../../data";
import header from "./shots/header.png";
import sidebar from "./shots/sidebar.png";
import mToday from "./shots/m-today.png";
import mBoard from "./shots/m-board.png";
import mRole from "./shots/m-role.png";
import mInterviews from "./shots/m-interviews.png";
import mInsights from "./shots/m-insights.png";
import bCard from "./shots/b-card.png";
import bBelow from "./shots/b-below.png";
import bAppliedBottom from "./shots/b-applied-bottom.png";
import bScreenBottom from "./shots/b-screen-bottom.png";

const problem =
  "Recruiters pitch five roles in one call. Processes drag on for six rounds. Half the companies ghost you. And your spreadsheet has no idea who to chase today.";

// The tour's chapters (index = data-ch). `page` is what the window shows; the tints run lilac, sky, peach and dusk.
const chapters = [
  {
    id: "c2-today",
    page: "today",
    tint: "sky",
    eyebrow: "Today",
    title: "Know exactly who to chase today.",
    body: "Your move, what's coming up and who you're waiting on, before the coffee's cool. Tick a to-do, chase, snooze or call it ghosted in one click.",
    still: mToday,
    alt: "The Today page: your move, what's coming up and who you're waiting on",
  },
  {
    id: "c2-board",
    page: "board",
    tint: "peach",
    eyebrow: "The board",
    title: "Every application, one drag away.",
    body: "Drag between stages, see the interview round on each card and who's gone quiet in red. Undo a move you didn't mean.",
    still: mBoard,
    alt: "The board of applications by stage",
  },
  {
    id: "c2-roles",
    page: "role",
    tint: "lilac",
    eyebrow: "Recruiters and roles",
    title: "One recruiter, five roles, zero chaos.",
    body: "Log the call, add each role they pitched, then apply or pass with a reason. Drop the job description on the role: it follows it onto your application.",
    still: mRole,
    alt: "A role's page: pay, the recruiter who pitched it, notes, to-dos and links",
  },
  {
    id: "c2-interviews",
    page: "interviews",
    tint: "sky",
    eyebrow: "Interviews",
    title: "Every round, on one calendar.",
    body: "Rounds in your own words, with prep and debrief notes. See what's held, what's coming up and what moved, by month or by year.",
    still: mInterviews,
    alt: "The interviews calendar for November, with one round coming up",
  },
  {
    id: "c2-insights",
    page: "insights",
    tint: "peach",
    eyebrow: "Insights",
    title: "See where it all leaks.",
    body: "Every role's path, from who brought it to an offer or to ghosted. Conversion per stage, time in stage and a scorecard for every recruiter.",
    still: mInsights,
    alt: "A Sankey diagram of a whole job search, from where roles came from to where they ended",
  },
];

const tree = [
  ["jat.sqlite", "the database"],
  ["export/applications.jsonl", "readable without the app"],
  ["notes/contoso-backend.md", "your notes, plain Markdown"],
  ["files/backend-cv-v3.pdf", "CVs, briefs, emails"],
  [".git/", "snapshots, if you want them"],
];

const extras = [...MARQUEE[1], "English and 简体中文", "Offers side by side", "Timeline"];
// Where each chip floats around the shrunken window (left %, top %), and how far it travels in.
const spots = [
  [6, 22],
  [74, 18],
  [3, 46],
  [80, 40],
  [9, 70],
  [76, 64],
  [20, 86],
  [62, 86],
  [30, 12],
  [55, 10],
  [86, 84],
];
---

<div class="c2-tour" id="c2-top" data-tour>
  <div class="c2-stage" aria-hidden="true" data-stage>
    <div class="c2-pose" data-pose>
      <div class="c2-drift">
        <div class="c2-win" data-win>
          <div class="c2-layer c2-data">
            <p class="c2-data-path">~/job-search-data</p>
            <ul>
              {
                tree.map(([f, why]) => (
                  <li>
                    <code>{f}</code>
                    <span>{why}</span>
                  </li>
                ))
              }
            </ul>
            <p class="c2-data-foot">One folder. Ordinary files. On your computer.</p>
          </div>
          <div class="c2-layer c2-frame">
            <div class="c2-titlebar">
              <span class="c2-lights"><i></i><i></i><i></i></span>
              <span class="c2-url">
                <svg viewBox="0 0 16 16" width="11" height="11"
                  ><path
                    d="M4.5 7V5a3.5 3.5 0 0 1 7 0v2M3.5 7h9v6.5h-9z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"></path></svg
                >
                127.0.0.1:8770
              </span>
            </div>
          </div>
          <div class="c2-screen" data-screen>
            <div class="c2-app" data-app>
              <div class="c2-layer c2-main">
                <div class="c2-pg is-on" data-page="today">
                  <div class="c2-pg-in" data-scroll>
                    <Image src={mToday} alt="" loading="eager" />
                    <span class="c2-tick" data-tick
                      ><svg viewBox="0 0 16 16"
                        ><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="#fff" stroke-width="2.2"></path></svg
                      ></span
                    >
                    <span class="c2-strike" data-strike></span>
                  </div>
                </div>
                <div class="c2-pg" data-page="board">
                  <div class="c2-pg-in" data-scroll>
                    <Image src={mBoard} alt="" />
                    <span class="c2-b c2-b-bg" data-b="bg"></span>
                    <span class="c2-b c2-b-white" data-b="white"></span>
                    <Image src={bBelow} alt="" class="c2-b c2-b-below" data-b="below" />
                    <Image src={bAppliedBottom} alt="" class="c2-b c2-b-abot" data-b="abot" />
                    <span class="c2-b c2-b-ext" data-b="ext"></span>
                    <Image src={bScreenBottom} alt="" class="c2-b c2-b-sbot" data-b="sbot" />
                    <span class="c2-b c2-b-count" data-b="count">1</span>
                    <Image src={bCard} alt="" class="c2-b c2-b-card" data-b="card" />
                  </div>
                </div>
                <div class="c2-pg" data-page="role">
                  <div class="c2-pg-in" data-scroll>
                    <Image src={mRole} alt="" />
                    <span class="c2-badge" data-badge><b>Applied</b></span>
                  </div>
                </div>
                <div class="c2-pg" data-page="interviews">
                  <div class="c2-pg-in" data-scroll>
                    <Image src={mInterviews} alt="" />
                    <span class="c2-ring" data-ring></span>
                  </div>
                </div>
                <div class="c2-pg" data-page="insights">
                  <div class="c2-pg-in" data-scroll>
                    <Image src={mInsights} alt="" />
                    <span class="c2-cover" data-cover></span>
                  </div>
                </div>
              </div>
              <div class="c2-layer c2-side">
                <span class="c2-hl" data-hl></span>
                <Image src={sidebar} alt="" loading="eager" />
              </div>
              <div class="c2-layer c2-head">
                <Image src={header} alt="" loading="eager" />
              </div>
              <div class="c2-layer c2-touch">
                <span class="c2-tip c2-glass" data-tip>Offer · 2 roles deciding</span>
                <span class="c2-cursor" data-cursor>
                  <span class="c2-ripple" data-ripple></span>
                  <svg viewBox="0 0 24 24" width="26" height="26"
                    ><path
                      d="M5 3.2v15.6l4.3-4.1 2.7 6.1 2.8-1.2-2.7-6h6z"
                      fill="#1d1838"
                      stroke="#fff"
                      stroke-width="1.6"
                      stroke-linejoin="round"></path></svg
                  >
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <nav class="c2-rail c2-glass" aria-label="Tour chapters" data-rail>
    {
      chapters.map((c, i) => (
        <a href={`#${c.id}`} data-rail-i={i + 2}>
          <i />
          <span>{c.eyebrow}</span>
        </a>
      ))
    }
    <a href="#c2-privacy" data-rail-i="7"><i /><span>Under the glass</span></a>
  </nav>

  <main class="c2-chapters" id="c2-main">
    <section class="c2-ch c2-ch--hero" data-ch="0" data-tint-block="lilac" aria-labelledby="c2-h1">
      <div class="c2-hero">
        <p class="c2-eyebrow">Private job application tracker</p>
        <h1 class="c2-display" id="c2-h1">Your job search,<br />on your machine.</h1>
        <p class="c2-hero-sub">
          Track every application, recruiter, interview round, follow-up and offer. It runs on your own computer: no
          account, no subscription, nobody watching.
        </p>
        <div class="c2-hero-ctas">
          <a class="c2-glass c2-btn c2-btn--ink" href="#c2-quickstart"><span>Get started, it's free</span></a>
          <a class="c2-glass c2-btn" href="#c2-today"><span>Take the tour</span></a>
        </div>
        <ul class="c2-promises" aria-label="Promises">
          <li>Free and open source</li>
          <li>No sign-up</li>
          <li>No AI, no cloud</li>
          <li>No tracking</li>
        </ul>
      </div>
      <figure class="c2-still c2-still--hero">
        <Image src={mToday} alt="The Today page of the app (made-up demo data)" />
      </figure>
    </section>

    <section class="c2-ch c2-ch--problem" data-ch="1" data-tint-block="sky" aria-labelledby="c2-problem">
      <div class="c2-problem c2-glass">
        <p class="c2-eyebrow" id="c2-problem">The problem</p>
        <p class="c2-words" data-words>
          {problem.split(" ").map((w) => <span>{w} </span>)}
        </p>
        <p class="c2-answer">So here's a CRM for your job hunt.</p>
      </div>
    </section>

    {
      chapters.map((c, i) => (
        <section class="c2-ch c2-ch--app" id={c.id} data-ch={i + 2} data-tint-block={c.tint}>
          <div class="c2-cap c2-glass">
            <p class="c2-eyebrow">{c.eyebrow}</p>
            <h2 class="c2-display">{c.title}</h2>
            <p>{c.body}</p>
          </div>
          <figure class="c2-still">
            <Image src={c.still} alt={`${c.alt} (made-up demo data)`} />
          </figure>
        </section>
      ))
    }

    <section class="c2-ch c2-ch--privacy" id="c2-privacy" data-ch="7" data-tint-block="dusk">
      <div class="c2-cap c2-cap--left c2-glass">
        <p class="c2-eyebrow">Under the glass</p>
        <h2 class="c2-display">Three layers.<br />All of them yours.</h2>
        <p>
          Your browser, the app on 127.0.0.1, and one folder of ordinary files you can read without it. No AI, no
          cloud, no account and no tracking. It never sends email, contacts anyone or calls out to the web.
        </p>
        <p class="c2-cap-small">
          Back up with one zip from the sidebar, or let the folder keep its own git history and <code>jat push</code>
          it to a private repo you own.
        </p>
      </div>
      <figure class="c2-still c2-still--data">
        <p class="c2-data-path">~/job-search-data</p>
        <ul>
          {
            tree.map(([f, why]) => (
              <li>
                <code>{f}</code> <span>{why}</span>
              </li>
            ))
          }
        </ul>
      </figure>
    </section>

    <section class="c2-ch c2-ch--outro" data-ch="8" data-tint-block="lilac" aria-labelledby="c2-extras" data-outro>
      <div class="c2-outro">
        <div class="c2-outro-head">
          <p class="c2-eyebrow" id="c2-extras">Also in the box</p>
          <h2 class="c2-display">The small things that<br />save an afternoon.</h2>
        </div>
        <ul class="c2-chips">
          {
            extras.map((x, i) => (
              <li
                class="c2-glass"
                style={`--l:${spots[i % spots.length][0]}%;--t:${spots[i % spots.length][1]}%;--i:${i}`}
                set:html={x.replace(/[一-鿿]+/g, '<span lang="zh-CN">$&</span>')}
              />
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</div>

<script>
  import "./tour";
</script>

<style is:global>
  .c2-tour {
    position: relative;
    z-index: 1;
  }

  /* ---------- The stage and the window ---------- */
  .c2-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    perspective: 1700px;
    perspective-origin: 50% 45%;
    display: grid;
    place-items: center;
    pointer-events: none;
    z-index: 0;
  }
  .c2-pose,
  .c2-drift,
  .c2-win,
  .c2-screen,
  .c2-app {
    transform-style: preserve-3d;
  }
  .c2-pose {
    /* The hero pose until the script takes over. */
    transform: translate3d(20vw, 8vh, 0) scale(0.52) rotateX(14deg) rotateY(-22deg) rotateZ(2deg);
    will-change: transform;
  }
  .c2-drift {
    animation: c2-drift 14s ease-in-out infinite alternate;
  }
  @keyframes c2-drift {
    0% {
      transform: rotateX(1.2deg) rotateY(-1.6deg) translate3d(0, -4px, 0);
    }
    50% {
      transform: rotateX(-1deg) rotateY(1.4deg) translate3d(0, 6px, 0);
    }
    100% {
      transform: rotateX(0.6deg) rotateY(-0.4deg) translate3d(0, -2px, 0);
    }
  }
  .c2-win {
    --s: 0.6;
    --x: 0;
    --sw: calc(1440px * var(--s));
    --sh: calc(900px * var(--s));
    position: relative;
    width: var(--sw);
    height: calc(var(--sh) + 44px);
  }
  .c2-layer {
    position: absolute;
    backface-visibility: hidden;
  }
  .c2-frame {
    inset: -9px;
    border-radius: 24px;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.85), rgb(255 255 255 / 0.45) 40%, rgb(236 230 255 / 0.6)),
      linear-gradient(180deg, #fff, #f3f0ff);
    box-shadow:
      inset 0 1px 0 #fff,
      inset 0 0 0 1px rgb(255 255 255 / 0.7),
      0 0 0 1px rgb(120 100 220 / 0.12),
      0 50px 120px -30px rgb(50 30 130 / 0.45),
      0 20px 40px -20px rgb(50 30 130 / 0.3);
    transform: translateZ(calc(var(--x) * -260px));
    /* Exploded, the frame thins to frosted glass so the data folder shows through. */
    opacity: calc(1 - var(--x) * 0.6);
  }
  .c2-frame::after {
    /* A sheen sweeping across the glass frame. */
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.6) 42%, transparent 52%);
    opacity: 0.5;
  }
  .c2-titlebar {
    position: relative;
    z-index: 1;
    height: 53px;
    display: flex;
    align-items: center;
    padding: 0 18px;
  }
  .c2-lights {
    display: flex;
    gap: 7px;
  }
  .c2-lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff8a7a;
    box-shadow: inset 0 -1px 2px rgb(0 0 0 / 0.15);
  }
  .c2-lights i:nth-child(2) {
    background: #ffcc66;
  }
  .c2-lights i:nth-child(3) {
    background: #7fd6a0;
  }
  .c2-url {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    border-radius: 999px;
    font: 450 12px/1 var(--c2-mono);
    color: var(--c2-ink-2);
    background: rgb(255 255 255 / 0.7);
    box-shadow:
      inset 0 1px 0 #fff,
      0 1px 3px rgb(60 40 140 / 0.12);
  }
  .c2-screen {
    position: absolute;
    left: 0;
    top: 44px;
    width: var(--sw);
    height: var(--sh);
  }
  .c2-app {
    position: absolute;
    left: 0;
    top: 0;
    width: 1440px;
    height: 900px;
    transform-origin: 0 0;
    transform: translateX(var(--pan, 0px)) scale(var(--s));
  }
  .c2-app img {
    display: block;
    max-width: none;
    height: auto;
  }
  .c2-main {
    left: 230px;
    top: 56px;
    width: 1210px;
    height: 844px;
    overflow: hidden;
    background: #fff;
    border-radius: 0 0 14px 0;
  }
  .c2-side {
    left: 0;
    top: 56px;
    width: 230px;
    height: 844px;
    background: #fff;
    border-radius: 0 0 0 14px;
    isolation: isolate;
    transform: translateZ(calc(var(--x) * 180px));
    box-shadow: calc(var(--x) * 30px) 0 calc(var(--x) * 50px) rgb(50 30 130 / calc(var(--x) * 0.25));
  }
  .c2-side img {
    mix-blend-mode: multiply;
    position: relative;
  }
  .c2-hl {
    position: absolute;
    left: 10px;
    top: 0;
    width: 209px;
    height: 41px;
    border-radius: 6px;
    background: rgb(219 228 255);
    transform: translateY(10px);
    transition: transform 0.45s var(--c2-ease);
  }
  .c2-head {
    left: 0;
    top: 0;
    width: 1440px;
    height: 56px;
    overflow: hidden;
    border-bottom: 1px solid #e9ecef;
    transform: translateZ(calc(var(--x) * 340px));
    box-shadow: 0 calc(var(--x) * 20px) calc(var(--x) * 40px) rgb(50 30 130 / calc(var(--x) * 0.25));
  }
  .c2-touch {
    inset: 0;
    pointer-events: none;
    transform: translateZ(calc(var(--x) * 460px + 1px));
  }
  .c2-data {
    left: 0;
    top: 44px;
    width: var(--sw);
    height: var(--sh);
    padding: calc(var(--s) * 70px) calc(var(--s) * 80px);
    border-radius: 18px;
    color: var(--c2-ink);
    background:
      radial-gradient(70% 80% at 0% 0%, rgb(201 184 255 / 0.9), transparent 70%),
      radial-gradient(60% 70% at 100% 100%, rgb(255 198 171 / 0.9), transparent 70%),
      linear-gradient(160deg, #f4f0ff, #e2f1ff);
    box-shadow:
      inset 0 1px 0 #fff,
      0 40px 80px -30px rgb(0 0 0 / 0.6);
    transform: translateZ(calc(var(--x) * -540px));
    opacity: var(--x);
    font-size: calc(var(--s) * 30px);
  }
  .c2-data-path,
  .c2-still--data .c2-data-path {
    font: 500 1.3em/1 var(--c2-mono);
    margin-bottom: 1.2em;
  }
  .c2-data ul,
  .c2-still--data ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7em;
  }
  .c2-data li,
  .c2-still--data li {
    display: flex;
    justify-content: space-between;
    gap: 1em;
    padding-bottom: 0.7em;
    border-bottom: 1px solid rgb(33 28 59 / 0.12);
  }
  .c2-still--data li {
    border-color: rgb(255 255 255 / 0.12);
  }
  .c2-data code,
  .c2-still--data code {
    font-family: var(--c2-mono);
  }
  .c2-data li span,
  .c2-still--data li span {
    opacity: 0.6;
    font-weight: 300;
  }
  .c2-data-foot {
    position: absolute;
    bottom: calc(var(--s) * 60px);
    font-weight: 300;
    font-size: 1.4em;
    letter-spacing: -0.02em;
  }
  /* Pages inside the window. */
  .c2-pg {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
  }
  .c2-pg.is-on {
    opacity: 1;
    visibility: visible;
  }
  .c2-pg-in {
    position: relative;
    will-change: transform;
  }
  .c2-tick {
    position: absolute;
    left: 751px;
    top: 390px;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    background: #4c6ef5;
    opacity: 0;
    transform: scale(0.4);
  }
  .c2-tick svg {
    width: 20px;
    height: 20px;
  }
  .c2-strike {
    position: absolute;
    left: 779px;
    top: 397px;
    width: 213px;
    height: 2px;
    background: #495057;
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .c2-b {
    position: absolute;
  }
  .c2-b-bg {
    left: 289px;
    top: 219px;
    width: 228px;
    height: 380px;
    background: #f8f9fa;
    opacity: 0;
  }
  .c2-b-white {
    left: 277px;
    top: 520px;
    width: 252px;
    height: 92px;
    background: #fff;
    opacity: 0;
  }
  .c2-b-below {
    left: 289px;
    top: 310px;
  }
  .c2-b-abot {
    left: 278px;
    top: 599px;
  }
  .c2-b-ext {
    left: 540px;
    top: 274px;
    width: 250px;
    height: 92px;
    background: #f8f9fa;
    border: solid #ced4da;
    border-width: 0 1px;
    transform: scaleY(0);
    transform-origin: 50% 0;
  }
  .c2-b-sbot {
    left: 540px;
    top: 274px;
  }
  .c2-b-count {
    left: 768px;
    top: 189px;
    width: 18px;
    height: 18px;
    font: 400 12px/18px "Inter Variable", sans-serif;
    text-align: center;
    color: #868e96;
    background: #f8f9fa;
    opacity: 0;
  }
  .c2-b-card {
    left: 289px;
    top: 219px;
    border-radius: 8px;
  }
  .c2-b-card.is-lifted {
    box-shadow: 0 18px 30px -8px rgb(40 30 100 / 0.35);
  }
  .c2-stage.is-paused .c2-drift {
    animation-play-state: paused;
  }
  .c2-badge {
    position: absolute;
    left: 417px;
    top: 58px;
    width: 104px;
    height: 26px;
