---
// Concept 2, "Liquid" (docs/rfc/website-redesign.md): its own shell, so none of the current site's global CSS
// applies here. Fonts, the moving gradient mesh, the fixed liquid-glass chrome and the page's base styles.
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "./c2.css";
import Switcher from "../Switcher.astro";
import { REPO } from "../../data";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="c2">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Concept 2 · Liquid · Job Application Tracker</title>
    <meta
      name="description"
      content="Design concept: a private, local-first job application tracker, toured inside the app."
    />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="c2-body" data-tint="lilac">
    <a class="c2-skip" href="#c2-main">
      Skip to content
    </a>

    <!-- The mesh: three soft blobs drifting slowly, and a tint wash per section, cross-faded as you scroll. -->
    <div class="c2-mesh" aria-hidden="true">
      <div class="c2-blob c2-blob--a"></div>
      <div class="c2-blob c2-blob--b"></div>
      <div class="c2-blob c2-blob--c"></div>
      <div class="c2-blob c2-blob--d"></div>
      <div class="c2-wash c2-wash--lilac"></div>
      <div class="c2-wash c2-wash--sky"></div>
      <div class="c2-wash c2-wash--peach"></div>
      <div class="c2-wash c2-wash--dusk"></div>
    </div>

    <header class="c2-chrome">
      <a class="c2-glass c2-logo" href="#c2-top" aria-label="Job Application Tracker, back to the top">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <defs>
            <linearGradient id="c2-logo-g" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#7b6cff"></stop>
              <stop offset="1" stop-color="#ff9a7a"></stop>
            </linearGradient>
          </defs>
          <rect width="24" height="24" rx="7" fill="url(#c2-logo-g)"></rect>
          <g fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="7.5"></circle>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="12" cy="12" r="0.8"></circle>
          </g>
        </svg>
      </a>
      <nav class="c2-glass c2-navpill" aria-label="Main">
        <a href="#c2-today">Tour</a>
        <a href="#c2-privacy">Privacy</a>
        <a href="#c2-quickstart">Quick start</a>
        <a href="#c2-faq">FAQ</a>
      </nav>
      <a class="c2-glass c2-cta" href={REPO}>
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>
    </header>

    <slot />

    <a class="c2-glass c2-totop" href="#c2-top" aria-label="Back to the top">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6"></path>
      </svg>
    </a>
    <Switcher current="2" />

    <script>
      // The page tint: whichever [data-tint] block holds the middle of the screen sets the mesh's wash and the
      // chrome's colour. Cheap enough to run on scroll (a handful of rects).
      const blocks = [...document.querySelectorAll<HTMLElement>("[data-tint-block]")];
      let last = "";
      const pick = () => {
        const mid = innerHeight * 0.5;
        for (const b of blocks) {
          const r = b.getBoundingClientRect();
          if (r.top <= mid && r.bottom > mid) {
            const t = b.dataset.tintBlock!;
            if (t !== last) {
              document.body.dataset.tint = t;
              last = t;
            }
            return;
          }
        }
      };
      addEventListener("scroll", pick, { passive: true });
      addEventListener("resize", pick);
      pick();
    </script>
  </body>
</html>
